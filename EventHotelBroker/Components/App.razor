<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>

    <script src="js/auth-helpers.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="js/charts.js"></script>
    <!-- Google Maps & Map Helper -->
    <script>
        function initMapWithCoordinates() { console.log("Google Maps API callback triggered."); }
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyA7eRAscqIJa-F2uUfvyS-rg7dAg02sXCk&libraries=places,geometry&callback=initMapWithCoordinates" async defer></script>
    <script src="js/maphelper.js"></script>
    <script src="js/home-helpers.js"></script>

    <!-- Custom Blazor Reconnect Modal -->
    <style>
        #components-reconnect-modal {
            display: none !important;
        }
        #components-reconnect-modal.components-reconnect-show, 
        #components-reconnect-modal.components-reconnect-failed, 
        #components-reconnect-modal.components-reconnect-rejected {
            display: flex !important;
            position: fixed;
            inset: 0;
            background: rgba(240, 242, 245, 0.95);
            backdrop-filter: blur(10px);
            z-index: 99999;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }
        .reconnect-content {
            background: white;
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
            text-align: center;
            max-width: 420px;
            width: 90%;
            animation: pop-in 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .reconnect-icon-wrapper {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            box-shadow: 0 10px 20px rgba(217, 119, 6, 0.2);
        }
        .reconnect-btn {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            border: none;
            padding: 12px 32px;
            border-radius: 50px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 16px rgba(217, 119, 6, 0.2);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .reconnect-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 20px rgba(217, 119, 6, 0.3);
            color: white;
        }
        @keyframes pop-in {
            0% { transform: scale(0.9); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
    </style>
    <div id="components-reconnect-modal" class="my-reconnect-modal components-reconnect-hide">
        <div class="reconnect-content">
            <div class="reconnect-icon-wrapper">
                <i class="bi bi-arrow-clockwise" style="font-size: 2.2rem; color: white;"></i>
            </div>
            <h3 style="font-weight: 800; color: #1a1a1a; margin-bottom: 12px; font-size: 1.5rem;">Session Idle</h3>
            <p style="color: #6c757d; margin-bottom: 32px; font-size: 0.95rem; line-height: 1.6;">
                Your connection was paused to save resources. Please reload to resume your session.
            </p>
            <button class="reconnect-btn" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise"></i> Reload Safari Vents
            </button>
        </div>
    </div>

    <!-- Auto-reload Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const observer = new MutationObserver(function (mutations) {
                const modal = document.getElementById('components-reconnect-modal');
                if (modal && modal.classList.contains('components-reconnect-show')) {
                    location.reload();
                }
            });
            observer.observe(document.body, { attributes: true, childList: true, subtree: true, attributeFilter: ['class'] });
        });
    </script>
</body>
</html>
