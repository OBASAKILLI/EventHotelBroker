@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<!-- Floating WhatsApp Support Button -->
<div style="position:fixed;bottom:20px;right:20px;z-index:999;font-family:'Inter',sans-serif;user-select:none;">
    
    @if (!isOpen)
    {
        <!-- Collapsed Floating Action Pill -->
        <button type="button" 
                @onclick="() => isOpen = true" 
                style="display:flex;align-items:center;gap:10px;padding:12px 18px;background:#25D366;color:#FFFFFF;font-weight:700;font-size:13px;border-radius:50px;border:none;box-shadow:0 8px 24px rgba(37,211,102,0.35);cursor:pointer;transition:transform 0.2s ease;"
                onmouseover="this.style.transform='scale(1.05)'"
                onmouseout="this.style.transform='scale(1)'"
                title="Open WhatsApp Support">
            
            <!-- Official WhatsApp SVG Icon with Fixed Dimensions -->
            <svg width="20" height="20" viewBox="0 0 24 24" fill="#FFFFFF" style="width:20px;height:20px;min-width:20px;flex-shrink:0;">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            
            <span>WhatsApp Support</span>
        </button>
    }
    else
    {
        <!-- Authentic WhatsApp Chat Window Card -->
        <div style="width:360px;max-width:calc(100vw - 32px);height:500px;max-height:calc(100vh - 40px);background:#FFFFFF;border-radius:20px;box-shadow:0 12px 36px rgba(0,0,0,0.2);border:1px solid #E5E7EB;overflow:hidden;display:flex;flex-direction:column;">
            
            <!-- WhatsApp Classic Header (#075E54) -->
            <div style="background:#075E54;color:#FFFFFF;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;">
                
                <!-- Contact Info -->
                <div style="display:flex;align-items:center;gap:12px;">
                    <div style="width:38px;height:38px;border-radius:50%;background:#128C7E;display:flex;align-items:center;justify-content:center;color:#FFFFFF;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="#FFFFFF" style="width:20px;height:20px;">
                            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                        </svg>
                    </div>
                    <div>
                        <div style="font-weight:700;font-size:13px;line-height:1.2;">EventHotelBroker Support</div>
                        <div style="font-size:10px;color:rgba(255,255,255,0.8);">online &bull; Platform Assistance</div>
                    </div>
                </div>

                <!-- Close Button -->
                <button type="button" 
                        @onclick="() => isOpen = false" 
                        style="background:transparent;border:none;color:#FFFFFF;cursor:pointer;padding:4px;"
                        title="Close">
                    <i class="bi bi-x-lg" style="font-size:18px;"></i>
                </button>
            </div>

            <!-- WhatsApp Chat Canvas Background (#EFEAE2) -->
            <div style="flex:1;padding:14px;overflow-y:auto;background:#EFEAE2;display:flex;flex-direction:column;gap:10px;">
                <div style="text-align:center;margin:4px 0;">
                    <span style="background:#FFF4B3;border:1px solid #FFE885;color:#54656F;font-size:10px;font-weight:600;padding:4px 10px;border-radius:8px;">
                        EventHotelBroker Concierge &bull; 24/7 Support
                    </span>
                </div>

                <div style="align-self:flex-start;max-width:85%;display:flex;flex-direction:column;gap:2px;">
                    <div style="background:#FFFFFF;color:#1F2937;font-size:12px;padding:8px 12px;border-radius:12px;border-top-left-radius:0;box-shadow:0 1px 2px rgba(0,0,0,0.05);">
                        Hello! Welcome to EventHotelBroker Administrative Support. How can we help you today?
                    </div>
                    <span style="font-size:9px;color:#6B7280;padding-left:4px;">Just now</span>
                </div>

                @foreach (var msg in chatMessages)
                {
                    <div style="align-self:@(msg.IsUser ? "flex-end" : "flex-start");max-width:85%;display:flex;flex-direction:column;gap:2px;">
                        <div style="background:@(msg.IsUser ? "#DCF8C6" : "#FFFFFF");color:#1F2937;font-size:12px;padding:8px 12px;border-radius:12px;@(msg.IsUser ? "border-top-right-radius:0;" : "border-top-left-radius:0;")box-shadow:0 1px 2px rgba(0,0,0,0.05);">
                            @msg.Text
                        </div>
                        <span style="font-size:9px;color:#6B7280;padding:0 4px;text-align:@(msg.IsUser ? "right" : "left");">@msg.Time</span>
                    </div>
                }
            </div>

            <!-- Input Bar -->
            <div style="padding:10px;background:#F3F4F6;border-top:1px solid #E5E7EB;display:flex;align-items:center;gap:8px;">
                <input type="text" 
                       placeholder="Type a message..." 
                       @bind="newMessage" 
                       @bind:event="oninput" 
                       @onkeydown="HandleKeyDown"
                       style="flex:1;background:#FFFFFF;border:1px solid #D1D5DB;border-radius:20px;padding:8px 14px;font-size:12px;outline:none;" />
                <button type="button" 
                        @onclick="SendMessage" 
                        style="width:34px;height:34px;border-radius:50%;background:#075E54;color:#FFFFFF;border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;">
                    <i class="bi bi-send-fill" style="font-size:12px;"></i>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool isOpen = false;
    private string newMessage = "";
    private List<ChatMessage> chatMessages = new();

    private void SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage)) return;
        var text = newMessage.Trim();
        chatMessages.Add(new ChatMessage { Text = text, IsUser = true, Time = DateTime.Now.ToString("h:mm tt") });
        newMessage = "";

        // Automated friendly reply
        chatMessages.Add(new ChatMessage 
        { 
            Text = "Thank you for reaching out! A broker operations agent has been notified and will assist you shortly.", 
            IsUser = false, 
            Time = DateTime.Now.ToString("h:mm tt") 
        });
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SendMessage();
        }
    }

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsUser { get; set; }
        public string Time { get; set; } = "";
    }
}
