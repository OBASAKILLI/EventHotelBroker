@using EventHotelBroker.Components.Shared

@if (Items != null && Items.Any())
{
<nav aria-label="breadcrumb" style="margin-bottom: 16px;">
    <div class="breadcrumb-system" style="display: flex; align-items: center; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0;">
        @foreach (var item in Items)
        {
            <div class="breadcrumb-system-item @(item.IsActive ? "active" : "")" style="display: inline-flex; align-items: center; gap: 8px; list-style: none;">
                @if (!item.IsActive && !string.IsNullOrEmpty(item.Url))
                {
                    <a href="@item.Url" style="color: #6B7280; font-size: 12px; font-weight: 500; text-decoration: none; transition: color 0.15s ease;">@item.Text</a>
                }
                else
                {
                    <span style="color: @(item.IsActive ? "#DD7A28" : "#6B7280"); font-size: 12px; font-weight: @(item.IsActive ? "600" : "500");">@item.Text</span>
                }
                @if (item != Items.Last())
                {
                    <span class="breadcrumb-system-separator" style="color: #9CA3AF; font-size: 10px; display: inline-flex; align-items: center;">
                        <i class="bi bi-chevron-right"></i>
                    </span>
                }
            </div>
        }
    </div>
</nav>
}

@code {
    [Parameter]
    public List<BreadcrumbItem>? Items { get; set; }
}
