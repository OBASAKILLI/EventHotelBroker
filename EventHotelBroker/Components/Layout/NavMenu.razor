@using Microsoft.AspNetCore.Components.Authorization
@using EventHotelBroker.Utils
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="ehb-client-sidebar-wrapper" style="height: 100%; display: flex; flex-direction: column; justify-content: space-between; background: #1A1A1A; color: #FFFFFF; font-family: 'Inter', sans-serif;">
    <!-- Brand Logo Area -->
    <div class="ehb-sidebar-logo">
        <a href="/" class="ehb-sidebar-brand">
            <div class="ehb-sidebar-brand-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5m-4 0h4"></path>
                </svg>
            </div>
            <div>
                <div class="ehb-sidebar-brand-title">
                    <span>Safari</span> Vents
                </div>
                <div class="ehb-sidebar-brand-sub">Client Portal</div>
            </div>
        </a>
    </div>

    <!-- Navigation Scroll Area -->
    <div class="ehb-sidebar-nav">
        <!-- DISCOVER -->
        <div class="ehb-nav-section-title">Discover</div>
        <NavLink class="ehb-nav-item" href="" Match="NavLinkMatch.All" ActiveClass="active-nav-item">
            <i class="bi bi-house-door"></i>
            <span>Home</span>
        </NavLink>
        <NavLink class="ehb-nav-item" href="search" ActiveClass="active-nav-item">
            <i class="bi bi-search"></i>
            <span>Search Hotels</span>
        </NavLink>
        <NavLink class="ehb-nav-item" href="events" ActiveClass="active-nav-item">
            <i class="bi bi-calendar-event"></i>
            <span>Event Services</span>
        </NavLink>

        <!-- MY ACCOUNT -->
        <div class="ehb-nav-section-title">My Account</div>
        <NavLink class="ehb-nav-item" href="user/dashboard" ActiveClass="active-nav-item">
            <i class="bi bi-grid-1x2"></i>
            <span>Dashboard</span>
        </NavLink>
        <NavLink class="ehb-nav-item" href="my-bookings" ActiveClass="active-nav-item">
            <i class="bi bi-calendar-check"></i>
            <span>Hotel Bookings</span>
        </NavLink>
        <NavLink class="ehb-nav-item" href="my-event-bookings" ActiveClass="active-nav-item">
            <i class="bi bi-calendar2-event"></i>
            <span>Event Bookings</span>
        </NavLink>
        <NavLink class="ehb-nav-item" href="chat" ActiveClass="active-nav-item">
            <i class="bi bi-chat-dots"></i>
            <span>Messages</span>
        </NavLink>

        @if (isOwner)
        {
            <!-- MY BUSINESS -->
            <div class="ehb-nav-section-title">My Business</div>
            <NavLink class="ehb-nav-item" href="owner/dashboard" ActiveClass="active-nav-item">
                <i class="bi bi-briefcase"></i>
                <span>Owner Portal</span>
            </NavLink>
            <NavLink class="ehb-nav-item" href="owner/hotels" ActiveClass="active-nav-item">
                <i class="bi bi-building"></i>
                <span>My Hotels</span>
            </NavLink>
            <NavLink class="ehb-nav-item" href="owner/bookings" ActiveClass="active-nav-item">
                <i class="bi bi-calendar-check"></i>
                <span>Booking Requests</span>
            </NavLink>
        }
        else if (!isAdmin)
        {
            <!-- PARTNER WITH US -->
            <div class="ehb-nav-section-title">Partner With Us</div>
            <div class="nav-enroll-cta" @onclick="EnrollAsOwner" style="margin: 8px 0; cursor: pointer;">
                <div class="nav-enroll-icon"><i class="bi bi-shop"></i></div>
                <div class="nav-enroll-text">
                    <span class="nav-enroll-title">Add My Business</span>
                    <span class="nav-enroll-subtitle">List your venues &amp; gear</span>
                </div>
                <i class="bi bi-chevron-right nav-enroll-arrow"></i>
            </div>
        }
    </div>

    <!-- Sidebar Footer -->
    <div class="ehb-sidebar-footer">
        <a href="/" class="ehb-btn-sidebar-view">
            <i class="bi bi-box-arrow-up-right"></i>
            <span>View Public Site</span>
        </a>
        <a href="/logout" class="ehb-btn-sidebar-logout">
            <i class="bi bi-box-arrow-right"></i>
            <span>Sign out</span>
        </a>
    </div>
</div>

<!-- Enroll Confirmation Modal -->
@if (showEnrollModal)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.55);backdrop-filter:blur(4px);z-index:9999;display:flex;align-items:center;justify-content:center;">
        <div style="background:#ffffff;border-radius:16px;padding:28px;max-width:420px;width:90%;box-shadow:0 24px 64px rgba(0,0,0,0.25);border:1px solid #E5E7EB;font-family:'Inter', sans-serif;">
            <div style="text-align:center;margin-bottom:20px;">
                <div style="width:54px;height:54px;background:rgba(221,122,40,0.12);border:1px solid rgba(221,122,40,0.25);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
                    <i class="bi bi-shop" style="font-size:1.5rem;color:#DD7A28;"></i>
                </div>
                <h4 style="font-weight:800;color:#111827;margin-bottom:8px;letter-spacing:-0.02em;font-size:1.15rem;">Become a Business Owner</h4>
                <p style="color:#6B7280;font-size:0.85rem;line-height:1.5;margin:0;">Enroll as a Business Owner on Safari Vents to start listing hotels, venues, and event equipment for clients.</p>
            </div>
            @if (!string.IsNullOrEmpty(enrollError))
            {
                <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:10px 14px;margin-bottom:16px;color:#dc2626;font-size:0.85rem;">
                    <i class="bi bi-exclamation-circle me-2"></i>@enrollError
                </div>
            }
            <div style="display:flex;gap:10px;">
                <button @onclick="() => showEnrollModal = false" style="flex:1;padding:10px;border:1px solid #E5E7EB;border-radius:8px;background:#F9FAFB;color:#374151;font-weight:600;font-size:13px;cursor:pointer;">Cancel</button>
                <button @onclick="ConfirmEnroll" disabled="@isEnrolling"
                    style="flex:1;padding:10px;border:none;border-radius:8px;background:#DD7A28;color:white;font-weight:700;font-size:13px;cursor:pointer;box-shadow:0 3px 10px rgba(221,122,40,0.35);">
                    @if (isEnrolling)
                    { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Enroll Now
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isOwner = false;
    private bool isAdmin = false;
    private bool showEnrollModal = false;
    private bool isEnrolling = false;
    private string enrollError = "";
    private string currentUserId = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUserRoles();
    }

    private async Task LoadUserRoles()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var nameClaim = user.FindFirst(ClaimTypes.Name)?.Value ?? "";
            var parts = nameClaim.Split(',');
            currentUserId = parts.Length > 0 ? parts[0] : "";
            var accountType = parts.Length > 1 ? parts[1] : "";

            var accountTypeClaim = user.FindFirst("AccountType")?.Value ?? accountType;

            isAdmin = accountTypeClaim.Contains("Admin", StringComparison.OrdinalIgnoreCase);
            isOwner = accountTypeClaim.Contains("HotelOwner", StringComparison.OrdinalIgnoreCase) ||
                      accountTypeClaim.Contains("Owner", StringComparison.OrdinalIgnoreCase);
        }
    }

    private void EnrollAsOwner()
    {
        enrollError = "";
        showEnrollModal = true;
    }

    private async Task ConfirmEnroll()
    {
        isEnrolling = true;
        enrollError = "";
        StateHasChanged();

        try
        {
            Navigation.NavigateTo($"/enroll-as-owner?userId={currentUserId}", forceLoad: true);
        }
        catch (Exception ex)
        {
            enrollError = $"An error occurred: {ex.Message}";
            isEnrolling = false;
            StateHasChanged();
        }
    }
}
