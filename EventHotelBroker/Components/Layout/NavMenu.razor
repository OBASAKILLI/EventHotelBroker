@using Microsoft.AspNetCore.Components.Authorization
@using EventHotelBroker.Utils
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="ehb-client-sidebar-wrapper" style="height: 100%; display: flex; flex-direction: column; justify-content: space-between; background: #1A1A1A; color: #FFFFFF; font-family: 'Inter', sans-serif;">
    <!-- Brand Logo Area -->
    <div class="ehb-sidebar-logo">
        <a href="/" class="ehb-sidebar-brand">
            <div class="ehb-sidebar-brand-icon">
                <img src="/Images/safari-icon-amber.png" alt="Safari Vents" />
            </div>
            <div>
                <div class="ehb-sidebar-brand-title">
                    <span>Safari</span> Vents
                </div>
                <div class="ehb-sidebar-brand-sub">@(isOwner ? "Host & Client Hub" : "Client Portal")</div>
            </div>
        </a>
    </div>

    <!-- Navigation Scroll Area -->
    <div class="ehb-sidebar-nav" style="flex: 1; overflow-y: auto; padding: 10px 0;">
        <!-- EXPLORE & BOOK -->
        <div class="ehb-nav-section-title">Explore</div>
        <NavLink class="ehb-nav-item" href="" Match="NavLinkMatch.All" ActiveClass="active-nav-item">
            <i class="bi bi-house-door"></i>
            <span>Home</span>
        </NavLink>
        <NavLink class="ehb-nav-item" href="search" ActiveClass="active-nav-item">
            <i class="bi bi-search"></i>
            <span>Search Hotels</span>
        </NavLink>
        <NavLink class="ehb-nav-item" href="events" ActiveClass="active-nav-item">
            <i class="bi bi-calendar-event"></i>
            <span>Event Services</span>
        </NavLink>

        <!-- MY PERSONAL TRAVEL -->
        <div class="ehb-nav-section-title">My Travel &amp; Account</div>
        <NavLink class="ehb-nav-item" href="user/dashboard" ActiveClass="active-nav-item">
            <i class="bi bi-grid-1x2"></i>
            <span>Personal Dashboard</span>
        </NavLink>
        <NavLink class="ehb-nav-item" href="my-bookings" ActiveClass="active-nav-item">
            <i class="bi bi-calendar-check"></i>
            <span>My Hotel Bookings</span>
        </NavLink>
        <NavLink class="ehb-nav-item" href="my-event-bookings" ActiveClass="active-nav-item">
            <i class="bi bi-calendar2-event"></i>
            <span>My Event Bookings</span>
        </NavLink>
        <NavLink class="ehb-nav-item" href="chat" ActiveClass="active-nav-item">
            <i class="bi bi-chat-dots"></i>
            <span>Messages</span>
        </NavLink>

        @if (isOwner)
        {
            <!-- MY BUSINESS / VENUE HOST -->
            <div class="ehb-nav-section-title" style="color: #DD7A28; font-weight: 700; margin-top: 14px;">
                <i class="bi bi-briefcase-fill me-1" style="font-size: 10px;"></i> My Business &amp; Venues
            </div>
            <NavLink class="ehb-nav-item" href="owner/dashboard" ActiveClass="active-nav-item">
                <i class="bi bi-speedometer2"></i>
                <span>Business Overview</span>
            </NavLink>
            <NavLink class="ehb-nav-item" href="owner/hotels" ActiveClass="active-nav-item">
                <i class="bi bi-building"></i>
                <span>My Hotels</span>
            </NavLink>
            <NavLink class="ehb-nav-item" href="owner/create-hotel" ActiveClass="active-nav-item">
                <i class="bi bi-plus-circle"></i>
                <span>Add New Hotel</span>
            </NavLink>
            <NavLink class="ehb-nav-item" href="owner/event-packages" ActiveClass="active-nav-item">
                <i class="bi bi-gift"></i>
                <span>Event Packages</span>
            </NavLink>
            <NavLink class="ehb-nav-item" href="owner/event-equipments" ActiveClass="active-nav-item">
                <i class="bi bi-box-seam"></i>
                <span>Event Equipment</span>
            </NavLink>
            <NavLink class="ehb-nav-item" href="owner/bookings" ActiveClass="active-nav-item">
                <i class="bi bi-inbox-fill"></i>
                <span>Guest Requests</span>
            </NavLink>
            <NavLink class="ehb-nav-item" href="owner/analytics" ActiveClass="active-nav-item">
                <i class="bi bi-graph-up"></i>
                <span>Business Analytics</span>
            </NavLink>
        }
        else if (!isAdmin)
        {
            <!-- PARTNER WITH US -->
            <div class="ehb-nav-section-title">Partner With Us</div>
            <div class="nav-enroll-cta" @onclick="EnrollAsOwner" style="margin: 8px 12px; cursor: pointer; background: rgba(221, 122, 40, 0.12); border: 1px solid rgba(221, 122, 40, 0.3); border-radius: 10px; padding: 10px; display: flex; align-items: center; gap: 10px;">
                <div class="nav-enroll-icon" style="width: 32px; height: 32px; border-radius: 8px; background: #DD7A28; color: white; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0;"><i class="bi bi-shop"></i></div>
                <div class="nav-enroll-text" style="flex: 1;">
                    <span class="nav-enroll-title" style="display: block; font-size: 12px; font-weight: 700; color: #FFFFFF;">Add My Business</span>
                    <span class="nav-enroll-subtitle" style="display: block; font-size: 10.5px; color: #D1D5DB;">List venues &amp; gear</span>
                </div>
                <i class="bi bi-chevron-right nav-enroll-arrow" style="color: #DD7A28; font-size: 12px;"></i>
            </div>
        }
    </div>

    <!-- Sidebar Footer -->
    <div class="ehb-sidebar-footer" style="padding: 12px 14px; border-top: 1px solid rgba(255, 255, 255, 0.08);">
        <a href="/" class="ehb-btn-sidebar-view" style="display: flex; align-items: center; gap: 8px; color: #9CA3AF; text-decoration: none; font-size: 12px; padding: 6px 8px; border-radius: 6px; transition: color 0.15s;">
            <i class="bi bi-box-arrow-up-right"></i>
            <span>View Public Site</span>
        </a>
        <a href="/logout" class="ehb-btn-sidebar-logout" style="display: flex; align-items: center; gap: 8px; color: #EF4444; text-decoration: none; font-size: 12px; padding: 6px 8px; border-radius: 6px; margin-top: 4px; transition: color 0.15s;">
            <i class="bi bi-box-arrow-right"></i>
            <span>Sign out</span>
        </a>
    </div>
</div>

<!-- Enroll Confirmation Modal -->
@if (showEnrollModal)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.55);backdrop-filter:blur(4px);z-index:9999;display:flex;align-items:center;justify-content:center;">
        <div style="background:#ffffff;border-radius:16px;padding:28px;max-width:420px;width:90%;box-shadow:0 24px 64px rgba(0,0,0,0.25);border:1px solid #E5E7EB;font-family:'Inter', sans-serif;">
            <div style="text-align:center;margin-bottom:20px;">
                <div style="width:54px;height:54px;background:rgba(221,122,40,0.12);border:1px solid rgba(221,122,40,0.25);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
                    <i class="bi bi-shop" style="font-size:1.5rem;color:#DD7A28;"></i>
                </div>
                <h4 style="font-weight:800;color:#111827;margin-bottom:8px;letter-spacing:-0.02em;font-size:1.15rem;">Become a Business Owner</h4>
                <p style="color:#6B7280;font-size:0.85rem;line-height:1.5;margin:0;">Enroll as a Business Owner on Safari Vents to start listing hotels, venues, and event equipment for clients.</p>
            </div>
            @if (!string.IsNullOrEmpty(enrollError))
            {
                <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:10px 14px;margin-bottom:16px;color:#dc2626;font-size:0.85rem;">
                    <i class="bi bi-exclamation-circle me-2"></i>@enrollError
                </div>
            }
            <div style="display:flex;gap:10px;">
                <button @onclick="() => showEnrollModal = false" style="flex:1;padding:10px;border:1px solid #E5E7EB;border-radius:8px;background:#F9FAFB;color:#374151;font-weight:600;font-size:13px;cursor:pointer;">Cancel</button>
                <button @onclick="ConfirmEnroll" disabled="@isEnrolling"
                    style="flex:1;padding:10px;border:none;border-radius:8px;background:#DD7A28;color:white;font-weight:700;font-size:13px;cursor:pointer;box-shadow:0 3px 10px rgba(221,122,40,0.35);">
                    @if (isEnrolling)
                    { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Enroll Now
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isOwner = false;
    private bool isAdmin = false;
    private bool showEnrollModal = false;
    private bool isEnrolling = false;
    private string enrollError = "";
    private string currentUserId = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUserRoles();
    }

    private async Task LoadUserRoles()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var nameClaim = user.FindFirst(ClaimTypes.Name)?.Value ?? "";
            var parts = nameClaim.Split(',');
            currentUserId = parts.Length > 0 ? parts[0] : "";
            var accountType = parts.Length > 1 ? parts[1] : "";

            var accountTypeClaim = user.FindFirst("AccountType")?.Value ?? accountType;

            isAdmin = accountTypeClaim.Contains("Admin", StringComparison.OrdinalIgnoreCase);
            isOwner = accountTypeClaim.Contains("HotelOwner", StringComparison.OrdinalIgnoreCase) ||
                      accountTypeClaim.Contains("Owner", StringComparison.OrdinalIgnoreCase);
        }
    }

    private void EnrollAsOwner()
    {
        enrollError = "";
        showEnrollModal = true;
    }

    private async Task ConfirmEnroll()
    {
        isEnrolling = true;
        enrollError = "";
        StateHasChanged();

        try
        {
            Navigation.NavigateTo($"/enroll-as-owner?userId={currentUserId}", forceLoad: true);
        }
        catch (Exception ex)
        {
            enrollError = $"An error occurred: {ex.Message}";
            isEnrolling = false;
            StateHasChanged();
        }
    }
}