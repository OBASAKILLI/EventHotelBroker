@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IHttpContextAccessor HttpContextAccessor
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@using EventHotelBroker.Utils
@implements IDisposable

<link href="/css/design-system.css" rel="stylesheet" />
<link href="/css/dark-mode.css" rel="stylesheet" />
<link href="/css/mobile-native.css?v=27" rel="stylesheet" />

<ToastContainer />

<div class="modern-layout">
    <!-- Modern Sidebar â€” only shown when logged in -->
    @if (isLoggedIn)
    {
        <aside class="modern-sidebar @(sidebarCollapsed ? "collapsed" : "")">
            <NavMenu />
        </aside>
        
        <!-- Mobile Sidebar Backdrop -->
        <div class="sidebar-backdrop @(sidebarCollapsed ? "active" : "")" @onclick="CloseSidebar"></div>
    }

    <!-- Modern App Bar -->
    <header class="@(isLoggedIn ? "modern-app-bar" : "modern-app-bar no-sidebar")">
        <div class="app-bar-content">
            @if (isLoggedIn)
            {
                <button class="sidebar-toggle" @onclick="ToggleSidebar">
                    <i class="bi bi-list"></i>
                </button>
            }
            <div class="app-bar-brand">
                <a href="/" class="brand-link" style="text-decoration:none; display:flex; align-items:center; gap:10px;">
                    <img src="/Images/safari-icon-amber.png" alt="Safari Vents" style="width:34px; height:34px; border-radius:9px; flex-shrink:0; box-shadow:0 3px 10px rgba(221,122,40,0.3); display:block;" />
                    <span class="brand-text" style="font-family:'Inter', sans-serif; font-weight:800; font-size:1.1rem; color:#111827;">Safari <span style="color:#DD7A28;">Vents</span></span>
                </a>
            </div>
            <div class="app-bar-actions">
                <button class="app-bar-btn" title="Toggle Theme" @onclick="ToggleTheme">
                    @if (isDarkMode)
                    {
                        <i class="bi bi-sun"></i>
                    }
                    else
                    {
                        <i class="bi bi-moon"></i>
                    }
                </button>
                @if (isLoggedIn)
                {
                    <a href="/chat" class="app-bar-btn" title="Messages">
                        <i class="bi bi-chat-dots"></i>
                        <span class="notification-badge">3</span>
                    </a>
                    <button class="app-bar-btn" title="Notifications">
                        <i class="bi bi-bell"></i>
                        <span class="notification-badge">5</span>
                    </button>
                    <button class="app-bar-btn" title="Settings">
                        <i class="bi bi-gear"></i>
                    </button>
                    <div class="user-profile" style="cursor: pointer; position: relative;" @onclick="ToggleUserMenu">
                        <div class="user-avatar" style="background: #DD7A28; color: white;">
                            <span style="font-size: 0.85rem; font-weight: 700;">@userInitials</span>
                        </div>
                        <span class="user-name">@userName</span>
                        <i class="bi bi-chevron-down" style="font-size: 0.7rem; margin-left: 4px; color: #6b7280;"></i>
                    </div>
                    @if (showUserMenu)
                    {
                        <div style="position: absolute; top: 56px; right: 16px; background: #ffffff; border-radius: 16px; box-shadow: 0 16px 40px rgba(0,0,0,0.14); min-width: 240px; z-index: 2000; overflow: hidden; border: 1px solid #e8e2d8;">
                            <div style="padding: 16px; border-bottom: 1px solid #f4efe6;">
                                <div style="font-weight: 700; color: #18181b; font-size: 0.95rem;">@userName</div>
                                <div style="color: #6b7280; font-size: 0.8rem; margin-top: 2px;">@userEmail</div>
                                <span style="display: inline-block; margin-top: 8px; padding: 3px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 700; background: rgba(221,122,40,0.12); color: #DD7A28;">@userRole</span>
                            </div>
                            <a href="/profile" style="display: flex; align-items: center; gap: 10px; padding: 12px 18px; color: #374151; text-decoration: none; font-size: 0.88rem; font-weight: 500; transition: background 0.15s;" onmouseover="this.style.background='#faf7f2'" onmouseout="this.style.background='transparent'">
                                <i class="bi bi-person"></i> Profile
                            </a>
                            <div style="border-top: 1px solid #f4efe6;">
                                <button onclick="document.getElementById('logoutModal').style.display='flex'" style="display: flex; align-items: center; gap: 10px; padding: 12px 18px; color: #dc2626; background: none; border: none; width: 100%; text-align: left; font-size: 0.88rem; font-weight: 600; cursor: pointer; transition: background 0.15s;" onmouseover="this.style.background='#fef2f2'" onmouseout="this.style.background='transparent'">
                                    <i class="bi bi-box-arrow-right"></i> Log out
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="display: flex; gap: 10px; margin-left: 10px; align-items: center;">
                        <a href="/login" style="padding: 8px 18px; border-radius: 10px; border: 1px solid #e8e2d8; color: #374151; text-decoration: none; font-weight: 600; font-size: 0.88rem; transition: all 0.2s;" onmouseover="this.style.background='rgba(221,122,40,0.08)';this.style.borderColor='#DD7A28';this.style.color='#DD7A28';" onmouseout="this.style.background='transparent';this.style.borderColor='#e8e2d8';this.style.color='#374151';">Log in</a>
                        <a href="/register" style="padding: 8px 20px; border-radius: 10px; background: #DD7A28; color: white; text-decoration: none; font-weight: 700; font-size: 0.88rem; box-shadow: 0 4px 14px rgba(221,122,40,0.35); transition: all 0.2s;" onmouseover="this.style.background='#c56820'" onmouseout="this.style.background='#DD7A28'">Sign up</a>
                    </div>
                }
            </div>
        </div>
    </header>


    <!-- Main Content -->
    <main class="@(isLoggedIn ? "modern-main-content" : "modern-main-content no-sidebar")">
        <div class="content-wrapper">
            @Body
        </div>
    </main>

    <WhatsAppSupportWidget />

    <MobileBottomNav />

    <!-- Floating Chat Button -->
    <a href="/chat" class="floating-chat-btn" title="Open Messages">
        <i class="bi bi-chat-dots-fill"></i>
        <span class="chat-badge">3</span>
    </a>
</div>

<!-- Logout Confirmation Modal (JS-driven, works in static + interactive) -->
<div id="logoutModal" onclick="if(event.target===this)this.style.display='none'" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); backdrop-filter:blur(4px); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:#ffffff; border-radius:20px; padding:32px; max-width:400px; width:90%; box-shadow:0 24px 64px rgba(0,0,0,0.25); text-align:center; border:1px solid #e8e2d8;">
        <div style="width:60px; height:60px; border-radius:50%; background:#fef2f2; display:flex; align-items:center; justify-content:center; margin:0 auto 18px;">
            <i class="bi bi-box-arrow-right" style="font-size:1.6rem; color:#dc2626;"></i>
        </div>
        <h3 style="margin:0 0 8px; color:#18181b; font-size:1.25rem; font-weight:700;">Log out</h3>
        <p style="color:#6b7280; font-size:0.92rem; margin:0 0 24px; line-height:1.5;">Are you sure you want to log out of your Safari Vents account?</p>
        <div style="display:flex; gap:12px; justify-content:center;">
            <button onclick="document.getElementById('logoutModal').style.display='none'" style="padding:10px 24px; border-radius:10px; border:1px solid #e8e2d8; background:#f4efe6; color:#18181b; font-size:0.9rem; cursor:pointer; font-weight:600;">Cancel</button>
            <button onclick="window.location.href='/logout'" style="padding:10px 24px; border-radius:10px; border:none; background:#dc2626; color:white; font-size:0.9rem; cursor:pointer; font-weight:600;">Log out</button>
        </div>
    </div>
</div>

<style>
    .floating-chat-btn {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: #18181b;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        border: 2px solid rgba(221, 122, 40, 0.4);
        z-index: 1000;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        text-decoration: none;
    }

    .floating-chat-btn:hover {
        transform: scale(1.1);
        box-shadow: 0 12px 32px rgba(221, 122, 40, 0.4);
        background: #DD7A28;
        color: #ffffff;
    }

    .chat-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        background: #DD7A28;
        color: white;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.65rem;
        font-weight: 700;
        border: 2px solid #18181b;
    }
</style>

@code {
    private bool sidebarCollapsed = false;
    private bool showUserMenu = false;
    private bool isLoggedIn = false;
    private string userName = "";
    private string userEmail = "";
    private string userRole = "";
    private string userInitials = "";
    private bool isDarkMode = false;

    protected override void OnInitialized()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        NavManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (sidebarCollapsed)
        {
            sidebarCollapsed = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        NavManager.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUserFromCookieAsync();
            await LoadThemePreference();
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await InvokeAsync(async () =>
        {
            await LoadUserFromAuthStateAsync();
            StateHasChanged();
        });
    }

    private async Task LoadUserFromCookieAsync()
    {
        try
        {
            // Read JWT cookie via JS interop (works after circuit is established)
            var token = await JSRuntime.InvokeAsync<string>("authHelpers.getCookie", "JWToken");
            
            if (!string.IsNullOrEmpty(token))
            {
                // Cache token in auth state provider for this circuit
                var customAuth = (CustomAuthenticationStateProvider)AuthStateProvider;
                await customAuth.MarkUserAsAuthenticated(token);
                await LoadUserFromAuthStateAsync();
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MainLayout] Cookie read error: {ex.Message}");
        }
    }

    private async Task LoadUserFromAuthStateAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            
            if (authState?.User?.Identity?.IsAuthenticated == true)
            {
                var user = authState.User;
                
                userName = user.FindFirst(ClaimTypes.GivenName)?.Value ?? "User";
                userEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? "";
                userRole = user.FindFirst("AccountType")?.Value ?? user.FindFirst(ClaimTypes.Role)?.Value ?? "User";

                var namePartsForInitials = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                userInitials = namePartsForInitials.Length >= 2
                    ? $"{namePartsForInitials[0][0]}{namePartsForInitials[^1][0]}".ToUpper()
                    : (userName.Length >= 2 ? userName[..2].ToUpper() : userName.ToUpper());

                isLoggedIn = true;
            }
            else
            {
                isLoggedIn = false;
                userName = "";
                userEmail = "";
                userRole = "";
                userInitials = "";
            }
        }
        catch (Exception ex)
        {
            isLoggedIn = false;
        }
    }

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }

    private void CloseSidebar()
    {
        if (sidebarCollapsed)
        {
            sidebarCollapsed = false;
        }
    }

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        // Save preference to localStorage for persistence
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "darkMode", isDarkMode.ToString());
        
        // Apply or remove dark-mode class on body
        if (isDarkMode)
        {
            await JSRuntime.InvokeVoidAsync("document.body.classList.add", "dark-mode");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("document.body.classList.remove", "dark-mode");
        }
        
        StateHasChanged();
    }

    private async Task LoadThemePreference()
    {
        try
        {
            var darkModeStr = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "darkMode");
            if (!string.IsNullOrEmpty(darkModeStr))
            {
                isDarkMode = darkModeStr.ToLower() == "true";
                
                // Apply dark-mode class to body
                if (isDarkMode)
                {
                    await JSRuntime.InvokeVoidAsync("document.body.classList.add", "dark-mode");
                }
                
                StateHasChanged();
            }
        }
        catch
        {
            // Fallback to system preference if localStorage fails
            isDarkMode = await JSRuntime.InvokeAsync<bool>("window.matchMedia", "(prefers-color-scheme: dark)");
            
            if (isDarkMode)
            {
                await JSRuntime.InvokeVoidAsync("document.body.classList.add", "dark-mode");
            }
            
            StateHasChanged();
        }
    }

}

<div id="blazor-error-ui" class="modern-error-ui">
    <div class="error-content">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>An unhandled error has occurred.</span>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">Ã—</a>
    </div>
</div>
