@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IHttpContextAccessor HttpContextAccessor
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@using EventHotelBroker.Utils

<link href="/css/design-system.css" rel="stylesheet" />
<link href="/css/dark-mode.css" rel="stylesheet" />
<link href="/css/mobile-native.css?v=27" rel="stylesheet" />

<ToastContainer />

<div class="modern-layout home-layout">
    <!-- Modern Corporate App Bar -->
    <header class="modern-app-bar home-app-bar">
        <div class="app-bar-content">
            <a href="/" class="app-bar-brand" style="text-decoration:none; display:flex; align-items:center; gap:12px;">
                <img src="/Images/logo-transparent.png" alt="Safari Vents" class="navbar-brand-logo" />
            </a>

            <nav class="app-bar-nav-links d-none d-lg-flex">
                <a href="/search" class="nav-link-item"><i class="bi bi-buildings me-1"></i>Venues</a>
                <a href="/events" class="nav-link-item"><i class="bi bi-gift me-1"></i>Packages</a>
                <a href="/events?tab=equipment" class="nav-link-item"><i class="bi bi-speaker me-1"></i>Equipment</a>
                <a href="/search?category=Airbnb" class="nav-link-item"><i class="bi bi-house me-1"></i>Airbnb</a>
            </nav>
            <div class="app-bar-actions">
                <a href="/enroll-as-owner" class="nav-btn-list-venue d-none d-md-inline-flex">
                    <i class="bi bi-plus-circle"></i> List Your Venue
                </a>
                <button class="app-bar-btn" title="Toggle Theme" @onclick="ToggleTheme">
                    @if (isDarkMode)
                    {
                        <i class="bi bi-sun"></i>
                    }
                    else
                    {
                        <i class="bi bi-moon"></i>
                    }
                </button>
                @if (isLoggedIn)
                {
                    <a href="/chat" class="app-bar-btn" title="Messages">
                        <i class="bi bi-chat-dots"></i>
                        <span class="notification-badge">3</span>
                    </a>
                    <button class="app-bar-btn" title="Notifications">
                        <i class="bi bi-bell"></i>
                        <span class="notification-badge">5</span>
                    </button>
                    <button class="app-bar-btn" title="Settings">
                        <i class="bi bi-gear"></i>
                    </button>
                    <div class="user-profile" style="cursor: pointer; position: relative;" @onclick="ToggleUserMenu">
                        <div class="user-avatar">
                            <span>@userInitials</span>
                        </div>
                        <span class="user-name">@userName</span>
                        <i class="bi bi-chevron-down" style="font-size: 0.7rem; margin-left: 4px; color: #9ca3af;"></i>
                    </div>
                    @if (showUserMenu)
                    {
                        <div class="user-dropdown-menu">
                            <div class="user-dropdown-header">
                                <div class="dropdown-name">@userName</div>
                                <div class="dropdown-email">@userEmail</div>
                                <span class="dropdown-role-badge">@userRole</span>
                            </div>
                            <a href="/profile" class="dropdown-item">
                                <i class="bi bi-person"></i> Profile
                            </a>
                            <div class="dropdown-divider">
                                <button onclick="document.getElementById('logoutModalHome').style.display='flex'" class="dropdown-logout-btn">
                                    <i class="bi bi-box-arrow-right"></i> Log out
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="display: flex; gap: 10px; align-items: center; margin-left: 10px;">
                        <a href="/login" class="nav-btn-login">Log in</a>
                        <a href="/register" class="nav-btn-signup">Sign up</a>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- Main Content (full width, no sidebar offset) -->
    <main class="home-main-content">
        @Body

        <!-- Modern Corporate Footer -->
        <footer class="modern-footer">
            <div class="footer-top">
                <div class="container">
                    <div class="row g-4">
                        <div class="col-lg-4 col-md-6">
                            <div class="footer-brand mb-3">
                                <a href="/" style="text-decoration:none; display:inline-block;">
                                    <img src="/Images/logo-transparent.png" alt="Safari Vents" class="footer-brand-logo" />
                                </a>
                            </div>
                            <p class="footer-desc">
                                Kenya's premier venue & event broker platform. Connecting event planners with verified hotels, venues, and audio-visual equipment.
                            </p>
                            <div class="footer-socials">
                                <a href="#" class="social-link" title="Twitter"><i class="bi bi-twitter-x"></i></a>
                                <a href="#" class="social-link" title="Instagram"><i class="bi bi-instagram"></i></a>
                                <a href="#" class="social-link" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                                <a href="#" class="social-link" title="Facebook"><i class="bi bi-facebook"></i></a>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-6 col-6">
                            <h6 class="footer-heading">Explore</h6>
                            <ul class="footer-links">
                                <li><a href="/search">All Hotels</a></li>
                                <li><a href="/events">Event Packages</a></li>
                                <li><a href="/search?category=Airbnb">Airbnb & Villas</a></li>
                                <li><a href="/search?category=Restaurant">Restaurants</a></li>
                                <li><a href="/search">Equipment Rental</a></li>
                            </ul>
                        </div>

                        <div class="col-lg-3 col-md-6 col-6">
                            <h6 class="footer-heading">For Property Owners</h6>
                            <ul class="footer-links">
                                <li><a href="/enroll-as-owner">List Your Venue</a></li>
                                <li><a href="/owner/dashboard">Owner Dashboard</a></li>
                                <li><a href="/owner/analytics">Analytics & Insights</a></li>
                                <li><a href="/owner/bookings">Booking Requests</a></li>
                                <li><a href="/how-it-works">How It Works</a></li>
                            </ul>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <h6 class="footer-heading">Contact & Support</h6>
                            <ul class="footer-contact">
                                <li>
                                    <i class="bi bi-geo-alt-fill"></i>
                                    <span>Nairobi, Kenya</span>
                                </li>
                                <li>
                                    <i class="bi bi-envelope-fill"></i>
                                    <span>support@eventhotelbroker.com</span>
                                </li>
                                <li>
                                    <i class="bi bi-telephone-fill"></i>
                                    <span>+254 (0) 700 000 000</span>
                                </li>
                                <li>
                                    <i class="bi bi-shield-check"></i>
                                    <span>Verified M-PESA & Card Payments</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <div class="container">
                    <div class="d-flex flex-wrap justify-content-between align-items-center py-3">
                        <div class="copyright-text">
                            &copy; 2026 Safari Vents. All rights reserved.
                        </div>
                        <div class="footer-legal-links">
                            <a href="/privacy">Privacy Policy</a>
                            <span class="divider">&bull;</span>
                            <a href="/terms">Terms of Service</a>
                            <span class="divider">&bull;</span>
                            <a href="/security">Security</a>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </main>

    <MobileBottomNav />

    <!-- Floating Chat Button -->
    <a href="/chat" class="floating-chat-btn" title="Open Messages">
        <i class="bi bi-chat-dots-fill"></i>
        <span class="chat-badge">3</span>
    </a>
</div>

<!-- Logout Confirmation Modal (JS-driven) -->
<div id="logoutModalHome" onclick="if(event.target===this)this.style.display='none'" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); backdrop-filter:blur(4px); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:#ffffff; border-radius:20px; padding:32px; max-width:400px; width:90%; box-shadow:0 24px 64px rgba(0,0,0,0.25); text-align:center;">
        <div style="width:60px; height:60px; border-radius:50%; background:#fef2f2; display:flex; align-items:center; justify-content:center; margin:0 auto 18px;">
            <i class="bi bi-box-arrow-right" style="font-size:1.6rem; color:#dc2626;"></i>
        </div>
        <h3 style="margin:0 0 8px; color:#18181b; font-size:1.25rem; font-weight:700;">Log out</h3>
        <p style="color:#6b7280; font-size:0.92rem; margin:0 0 24px; line-height:1.5;">Are you sure you want to log out of your Safari Vents account?</p>
        <div style="display:flex; gap:12px; justify-content:center;">
            <button onclick="document.getElementById('logoutModalHome').style.display='none'" style="padding:10px 24px; border-radius:10px; border:1px solid #e5e7eb; background:#f9fafb; color:#374151; font-size:0.9rem; cursor:pointer; font-weight:600;">Cancel</button>
            <button onclick="window.location.href='/logout'" style="padding:10px 24px; border-radius:10px; border:none; background:#dc2626; color:white; font-size:0.9rem; cursor:pointer; font-weight:600;">Log out</button>
        </div>
    </div>
</div>

