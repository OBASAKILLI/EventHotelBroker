@if (isDarkMode)
{
    <style>
        body, html, .modern-layout.home-layout {
            background-color: #121214 !important;
            color: #d1d5db !important;
        }

        .home-main-content {
            background: #121214 !important;
        }

        .modern-hero {
            background: #18181b !important;
        }
        .how-it-works-section, .explore-section, .cta-section, .featured-section {
            background-color: #121214 !important;
            color: #d1d5db !important;
        }
        
        .hero-title, .stat-number, .stat-value, .section-title, .feature-title, .card-title, .venue-title,
        .price-amount, .equip-title-home, .hotel-name, .package-title, .cta-title {
            color: #ffffff !important;
        }
        .hero-subtitle, .stat-label, .section-subtitle, .feature-text, .card-subtitle, 
        .venue-location, .cta-text, .hotel-description, .package-description, .equip-desc-home,
        .price-label, .price-period {
            color: #9ca3af !important;
        }

        .modern-app-bar.home-app-bar,
        .modern-card,
        #logoutModalHome > div,
        .search-box, 
        .floating-card, 
        .feature-card, 
        .venue-card, 
        .hotel-card, 
        .package-card-home, 
        .equip-card-home, 
        .cta-card, 
        .cta-stat {
            background-color: #18181b !important;
            border-color: rgba(255, 255, 255, 0.08) !important;
            color: #ffffff !important;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4) !important;
        }
        
        .floating-card:hover, .feature-card:hover, .venue-card:hover, .hotel-card:hover, .package-card-home:hover, .equip-card-home:hover {
            border-color: #b86d26 !important;
            box-shadow: 0 12px 32px rgba(184, 109, 38, 0.25) !important;
            transform: translateY(-4px);
        }

        .search-box input {
            color: #ffffff !important;
        }
        .search-box input::placeholder {
            color: #6b7280 !important;
        }

        .modern-tabs {
            background-color: #18181b !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
        }
        .modern-tabs .nav-link {
            background-color: transparent !important;
            color: #9ca3af !important;
            border: none !important;
