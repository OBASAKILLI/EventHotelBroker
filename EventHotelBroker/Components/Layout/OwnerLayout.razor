@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using EventHotelBroker.Components.Shared
@using System.Security.Claims
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Owner Portal | Safari Vents</PageTitle>

<div class="ehb-admin-shell">
    
    <!-- Mobile Backdrop -->
    @if (isMobileSidebarOpen)
    {
        <div class="ehb-sidebar-backdrop" @onclick="() => isMobileSidebarOpen = false"></div>
    }

    <!-- Sidebar in Dark Matte Charcoal (#1A1A1A) -->
    <aside class="ehb-admin-sidebar @(isMobileSidebarOpen ? "open" : "")">
        
        <!-- Brand / Logo Area -->
        <div class="ehb-sidebar-logo">
            <a href="/owner/dashboard" class="ehb-sidebar-brand">
                <div class="ehb-sidebar-brand-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5m-4 0h4"></path>
                    </svg>
                </div>
                <div>
                    <div class="ehb-sidebar-brand-title">
                        <span>Safari</span> Vents
                    </div>
                    <div class="ehb-sidebar-brand-sub">Owner Portal</div>
                </div>
            </a>
            <button @onclick="() => isMobileSidebarOpen = false" class="d-md-none btn btn-sm text-secondary" style="border:none;background:transparent;color:#9CA3AF;">
                <i class="bi bi-x-lg" style="font-size:18px;"></i>
            </button>
        </div>

        <!-- Navigation Links -->
        <div class="ehb-sidebar-nav">
            
            <!-- OVERVIEW -->
            <div class="ehb-nav-section-title">Overview</div>
            <NavLink class="ehb-nav-item" ActiveClass="active-nav-item" href="owner/dashboard" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </NavLink>

            <!-- ACCOMMODATIONS -->
            <div class="ehb-nav-section-title">Accommodations</div>
            <NavLink class="ehb-nav-item" ActiveClass="active-nav-item" href="owner/hotels">
                <i class="bi bi-building"></i>
                <span>My Hotels</span>
            </NavLink>
            <NavLink class="ehb-nav-item" ActiveClass="active-nav-item" href="owner/create-hotel">
                <i class="bi bi-plus-circle"></i>
                <span>Add Hotel</span>
            </NavLink>
            <NavLink class="ehb-nav-item" ActiveClass="active-nav-item" href="owner/bookings">
                <i class="bi bi-calendar-check"></i>
                <span>Booking Requests</span>
            </NavLink>

            <!-- EVENTS & INVENTORY -->
            <div class="ehb-nav-section-title">Events &amp; Services</div>
            <NavLink class="ehb-nav-item" ActiveClass="active-nav-item" href="owner/event-packages">
                <i class="bi bi-gift"></i>
                <span>Event Packages</span>
            </NavLink>
            <NavLink class="ehb-nav-item" ActiveClass="active-nav-item" href="owner/create-package">
                <i class="bi bi-plus-square"></i>
                <span>Add Package</span>
            </NavLink>
            <NavLink class="ehb-nav-item" ActiveClass="active-nav-item" href="owner/event-equipments">
                <i class="bi bi-box-seam"></i>
                <span>Event Equipment</span>
            </NavLink>
            <NavLink class="ehb-nav-item" ActiveClass="active-nav-item" href="owner/create-equipment">
                <i class="bi bi-plus-lg"></i>
                <span>Add Equipment</span>
            </NavLink>

            <!-- INSIGHTS -->
            <div class="ehb-nav-section-title">Insights</div>
            <NavLink class="ehb-nav-item" ActiveClass="active-nav-item" href="owner/analytics">
                <i class="bi bi-graph-up"></i>
                <span>Analytics</span>
            </NavLink>
        </div>

        <!-- Sidebar Footer -->
        <div class="ehb-sidebar-footer">
            <a href="/" target="_blank" class="ehb-btn-sidebar-view">
                <i class="bi bi-box-arrow-up-right"></i>
                <span>View Public Site</span>
            </a>
            <a href="/logout" class="ehb-btn-sidebar-logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Sign out</span>
            </a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="ehb-admin-main">
        
        <!-- Top App Bar -->
        <header class="ehb-admin-header">
            <div class="ehb-header-left">
                <button @onclick="() => isMobileSidebarOpen = !isMobileSidebarOpen" class="d-md-none btn btn-sm p-1 text-secondary" style="border:none;background:transparent;">
                    <i class="bi bi-list" style="font-size:22px;"></i>
                </button>

                <!-- Portal Title Badge -->
                <div class="ehb-header-badge">
                    <div class="ehb-header-badge-avatar">OP</div>
                    <div>
                        <div class="ehb-header-badge-title">Safari Vents Owner</div>
                        <div class="ehb-header-badge-sub">Business Management</div>
                    </div>
                </div>

                <div class="ehb-live-indicator">
                    <span class="ehb-live-dot"></span>
                    <span>Live Platform</span>
                </div>
            </div>

            <!-- Header Right Actions -->
            <div class="ehb-header-right">
                
                <!-- Quick Search Bar -->
                <div class="ehb-search-box">
                    <i class="bi bi-search ehb-search-icon"></i>
                    <input type="text" placeholder="Quick search..." />
                    <span class="ehb-search-kbd">⌘K</span>
                </div>

                <!-- Notifications / Alerts Button -->
                <a href="/owner/bookings" class="ehb-header-btn" title="Booking Requests">
                    <i class="bi bi-bell"></i>
                    <span class="ehb-header-alert-dot"></span>
                </a>

                <!-- Refresh Button -->
                <button type="button" onclick="window.location.reload();" title="Refresh Page" class="ehb-header-btn">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>

                <!-- Profile Dropdown -->
                <div class="position-relative">
                    <div class="ehb-user-profile" @onclick="() => showUserMenu = !showUserMenu">
                        <div class="ehb-user-avatar">
                            @userName.Substring(0, 1).ToUpper()
                        </div>
                        <div class="ehb-user-info d-none d-sm-block">
                            <div class="ehb-user-name">@userName</div>
                            <div class="ehb-user-role">@userRole</div>
                        </div>
                    </div>

                    @if (showUserMenu)
                    {
                        <div class="ehb-sidebar-backdrop" style="background:transparent;" @onclick="() => showUserMenu = false"></div>
                        <div class="ehb-user-dropdown">
                            <div class="ehb-user-dropdown-header">
                                <p style="font-weight:700;font-size:12px;color:#111827;">@userName</p>
                                <p style="font-size:10px;color:#6B7280;margin-top:2px;">@userEmail</p>
                            </div>
                            <div class="ehb-user-dropdown-menu">
                                <a href="/owner/hotels" class="ehb-user-dropdown-item" @onclick="() => showUserMenu = false">
                                    <i class="bi bi-building"></i>
                                    <span>My Hotels</span>
                                </a>
                                <a href="/owner/create-hotel" class="ehb-user-dropdown-item" @onclick="() => showUserMenu = false">
                                    <i class="bi bi-plus-circle"></i>
                                    <span>Add New Hotel</span>
                                </a>
                                <a href="/owner/bookings" class="ehb-user-dropdown-item" @onclick="() => showUserMenu = false">
                                    <i class="bi bi-calendar-check"></i>
                                    <span>Booking Requests</span>
                                </a>
                                <hr style="margin:4px 0;border-color:#F3F4F6;" />
                                <a href="/logout" class="ehb-user-dropdown-item danger">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Sign out</span>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </header>

        <!-- Dynamic Body Area with Warm Cream Surface -->
        <div class="ehb-admin-content">
            @Body
        </div>

        <!-- WhatsApp Support Widget -->
        <WhatsAppSupportWidget />
    </main>
</div>

@code {
    private bool isMobileSidebarOpen = false;
    private bool showUserMenu = false;
    private string userName = "Venue Owner";
    private string userEmail = "owner@eventhotelbroker.com";
    private string userRole = "Hotel Owner";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user?.Identity != null && user.Identity.IsAuthenticated)
            {
                var rawName = user.FindFirst(ClaimTypes.GivenName)?.Value 
                    ?? user.FindFirst("FullName")?.Value 
                    ?? user.Identity.Name 
                    ?? "Venue Owner";

                if (rawName.Contains(",") || (rawName.Contains("-") && rawName.Length > 20))
                {
                    var email = user.FindFirst(ClaimTypes.Email)?.Value;
                    if (!string.IsNullOrEmpty(email) && email.Contains("@"))
                    {
                        var prefix = email.Split('@')[0];
                        rawName = char.ToUpper(prefix[0]) + prefix.Substring(1);
                    }
                    else
                    {
                        rawName = "Venue Owner";
                    }
                }

                userName = rawName;
                userEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? "owner@eventhotelbroker.com";
                userRole = "Hotel Owner";
            }
        }
        catch
        {
            // Default fallback
        }
    }
}
