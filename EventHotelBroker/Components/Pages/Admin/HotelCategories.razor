@page "/admin/hotel-categories"
@rendermode InteractiveServer
@using EventHotelBroker.Models
@using EventHotelBroker.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<PageTitle>Hotel Categories - Admin</PageTitle>

<link href="/css/admin-hotel-categories.css?v=1" rel="stylesheet" />

<div class="hc">
    <Breadcrumb Items="@breadcrumbItems" />

    <!-- Header -->
    <div class="hc-header">
        <div>
            <h1 class="hc-header-title"><i class="bi bi-tags"></i> Hotel Categories</h1>
            <p class="hc-header-sub">Manage service fees by hotel category</p>
        </div>
        <div style="display:flex;gap:0.5rem;">
            <button class="hc-btn hc-btn-refresh" @onclick="LoadData" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
            <button class="hc-btn hc-btn-primary" @onclick="NewCategory">
                <i class="bi bi-plus-lg"></i> New Category
            </button>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="hc-search-bar">
        <div class="hc-search-wrap">
            <i class="bi bi-search"></i>
            <input class="hc-search-input" placeholder="Search by name or rating..." @bind="searchTerm" @bind:event="oninput" />
        </div>
        <label class="hc-filter-check">
            <input type="checkbox" @bind="showInactive" />
            <span>Show inactive</span>
        </label>
    </div>

    @if (isLoading)
    {
        <div class="hc-card">
            <div class="hc-loading">
                <div class="hc-spinner"></div>
                <div class="hc-loading-text">Loading categories...</div>
            </div>
        </div>
    }
    else
    {
        <div class="hc-card">
            <div class="hc-card-header">
                <h5 class="hc-card-title"><i class="bi bi-table"></i> Categories</h5>
                <span class="hc-card-count">@FilteredCategories.Count() records</span>
            </div>
            <div style="overflow-x:auto;">
                <table class="hc-table">
                    <thead>
                        <tr>
                            <th style="width:80px;">ID</th>
                            <th>Name</th>
                            <th>Rating</th>
                            <th style="width:180px;">Service Fee (KES)</th>
                            <th>Status</th>
                            <th style="width:220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredCategories.Any())
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="hc-empty">
                                        <div class="hc-empty-icon"><i class="bi bi-inbox"></i></div>
                                        <div class="hc-empty-title">No categories found</div>
                                        <div class="hc-empty-text">Try adjusting your search filters.</div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var c in FilteredCategories)
                            {
                                <tr>
                                    <td><span class="hc-id">#@c.Id</span></td>
                                    <td>
                                        <div class="hc-name">@c.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(c.Description))
                                        {
                                            <div class="hc-desc">@c.Description</div>
                                        }
                                    </td>
                                    <td>@c.Rating</td>
                                    <td>@c.ServiceFee.ToString("N0")</td>
                                    <td>
                                        @if (c.IsActive)
                                        {
                                            <span class="hc-badge hc-badge-active"><i class="bi bi-check-circle"></i> Active</span>
                                        }
                                        else
                                        {
                                            <span class="hc-badge hc-badge-inactive"><i class="bi bi-slash-circle"></i> Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div style="display:flex;gap:0.375rem;flex-wrap:wrap;">
                                            <button class="hc-btn hc-btn-sm hc-btn-edit" @onclick="() => EditCategory(c)">
                                                <i class="bi bi-pencil"></i> Edit
                                            </button>

                                            @if (c.IsActive)
                                            {
                                                <button class="hc-btn hc-btn-sm hc-btn-deactivate" @onclick="() => DeactivateCategory(c)">
                                                    <i class="bi bi-slash-circle"></i> Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="hc-btn hc-btn-sm hc-btn-activate" @onclick="() => ActivateCategory(c)">
                                                    <i class="bi bi-check2-circle"></i> Activate
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="hc-toast hc-toast-error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@errorMessage</span>
            <button class="hc-toast-close" @onclick="() => errorMessage = null"><i class="bi bi-x-lg"></i></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="hc-toast hc-toast-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@successMessage</span>
            <button class="hc-toast-close" @onclick="() => successMessage = null"><i class="bi bi-x-lg"></i></button>
        </div>
    }
</div>

@if (showForm)
{
    <div class="hc-modal-overlay">
        <div class="hc-modal-wrapper">
            <div class="hc-modal-content">
                <div class="hc-modal-header">
                    <h5 class="hc-modal-title">
                        @if (editingId == 0)
                        {
                            <span><i class="bi bi-plus-lg"></i> New Category</span>
                        }
                        else
                        {
                            <span><i class="bi bi-pencil"></i> Edit Category</span>
                        }
                    </h5>
                    <button type="button" class="hc-close-btn" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="hc-modal-body">
                    <EditForm Model="formModel" OnValidSubmit="SaveCategory">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="hc-form-label">Name</label>
                                <InputText class="hc-form-control" @bind-Value="formModel.Name" />
                            </div>
                            <div class="col-md-6">
                                <label class="hc-form-label">Rating (e.g. 5-Star)</label>
                                <InputText class="hc-form-control" @bind-Value="formModel.Rating" />
                            </div>
                            <div class="col-md-6">
                                <label class="hc-form-label">Service Fee (KES)</label>
                                <InputNumber class="hc-form-control" @bind-Value="formModel.ServiceFee" />
                            </div>
                            <div class="col-md-6">
                                <label class="hc-form-label">Active</label>
                                <div class="hc-form-check">
                                    <InputCheckbox class="hc-form-check-input" @bind-Value="formModel.IsActive" />
                                    <label class="hc-form-check-label">Enabled</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="hc-form-label">Description</label>
                                <InputTextArea class="hc-form-control" @bind-Value="formModel.Description" rows="3" />
                            </div>
                        </div>

                        <div class="hc-modal-footer">
                            <button type="button" class="hc-btn hc-btn-cancel" @onclick="CloseForm">Cancel</button>
                            <button type="submit" class="hc-btn hc-btn-primary" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-check-lg"></i> Save</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isSaving = false;

    private List<HotelCategory> categories = new();
    private string searchTerm = "";
    private bool showInactive = false;

    private string? errorMessage;
    private string? successMessage;

    private bool showForm = false;
    private int editingId = 0;
    private HotelCategory formModel = new();

    private List<BreadcrumbItem> breadcrumbItems = new()
    {
        new BreadcrumbItem { Text = "Home", Url = "/" },
        new BreadcrumbItem { Text = "Admin Dashboard", Url = "/admin/dashboard" },
        new BreadcrumbItem { Text = "Hotel Categories", IsActive = true }
    };

    private IEnumerable<HotelCategory> FilteredCategories => categories.Where(c =>
    {
        if (!showInactive && !c.IsActive) return false;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim().ToLower();
            return (c.Name?.ToLower().Contains(term) ?? false)
                || (c.Rating?.ToLower().Contains(term) ?? false);
        }

        return true;
    });

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            successMessage = null;

            categories = await DbContext.HotelCategories
                .OrderBy(c => c.ServiceFee)
                .ThenBy(c => c.Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load categories: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NewCategory()
    {
        editingId = 0;
        formModel = new HotelCategory
        {
            IsActive = true,
            CreatedAt = DateTime.UtcNow
        };
        showForm = true;
    }

    private void EditCategory(HotelCategory c)
    {
        editingId = c.Id;
        formModel = new HotelCategory
        {
            Id = c.Id,
            Name = c.Name,
            Rating = c.Rating,
            ServiceFee = c.ServiceFee,
            Description = c.Description,
            IsActive = c.IsActive,
            CreatedAt = c.CreatedAt
        };
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        editingId = 0;
        formModel = new HotelCategory();
    }

    private async Task SaveCategory()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            if (editingId == 0)
            {
                var entity = new HotelCategory
                {
                    Name = formModel.Name?.Trim() ?? "",
                    Rating = formModel.Rating?.Trim() ?? "",
                    ServiceFee = formModel.ServiceFee,
                    Description = formModel.Description,
                    IsActive = formModel.IsActive,
                    CreatedAt = DateTime.UtcNow
                };

                DbContext.HotelCategories.Add(entity);
                await DbContext.SaveChangesAsync();
                successMessage = "Category created.";
            }
            else
            {
                var entity = await DbContext.HotelCategories.FirstOrDefaultAsync(x => x.Id == editingId);
                if (entity == null)
                {
                    errorMessage = "Category not found.";
                    return;
                }

                entity.Name = formModel.Name?.Trim() ?? "";
                entity.Rating = formModel.Rating?.Trim() ?? "";
                entity.ServiceFee = formModel.ServiceFee;
                entity.Description = formModel.Description;
                entity.IsActive = formModel.IsActive;

                await DbContext.SaveChangesAsync();
                successMessage = "Category updated.";
            }

            showForm = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Save failed: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeactivateCategory(HotelCategory c)
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            var entity = await DbContext.HotelCategories.FirstOrDefaultAsync(x => x.Id == c.Id);
            if (entity == null)
            {
                errorMessage = "Category not found.";
                return;
            }

            entity.IsActive = false;
            await DbContext.SaveChangesAsync();
            successMessage = "Category deactivated.";
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Action failed: {ex.Message}";
        }
    }

    private async Task ActivateCategory(HotelCategory c)
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            var entity = await DbContext.HotelCategories.FirstOrDefaultAsync(x => x.Id == c.Id);
            if (entity == null)
            {
                errorMessage = "Category not found.";
                return;
            }

            entity.IsActive = true;
            await DbContext.SaveChangesAsync();
            successMessage = "Category activated.";
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Action failed: {ex.Message}";
        }
    }
}
