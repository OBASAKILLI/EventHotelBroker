@page "/user/dashboard"
@rendermode InteractiveServer
@using EventHotelBroker.Models
@using EventHotelBroker.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using EventHotelBroker.Utils
@inject IBookingService BookingService
@inject IEventService EventService
@inject NavigationManager Navigation
@inject ToastService ToastService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>My Dashboard - Safari Vents</PageTitle>

<link href="/css/design-system.css" rel="stylesheet" />

<div class="ud-shell">
    <Breadcrumb Items="@breadcrumbItems" />

    @if (isLoading)
    {
        <div class="row g-3 mb-3">
            @for (int i = 0; i < 4; i++)
            {
                <div class="col-lg-3 col-md-6">
                    <LoadingSkeleton Type="LoadingSkeleton.SkeletonType.Custom" Height="80px" />
                </div>
            }
        </div>
        <div class="row g-3">
            <div class="col-lg-8">
                <LoadingSkeleton Type="LoadingSkeleton.SkeletonType.Card" />
            </div>
            <div class="col-lg-4">
                <LoadingSkeleton Type="LoadingSkeleton.SkeletonType.Card" />
            </div>
        </div>
    }
    else
    {
        <!-- Welcome Banner -->
        <div class="ud-welcome">
            <div class="ud-welcome-left">
                <h1 class="ud-title">Welcome back!</h1>
                <p class="ud-subtitle">@DateTime.Now.ToString("dddd, MMMM dd yyyy")</p>
            </div>
            <div class="ud-welcome-right">
                <a href="/search" class="ud-btn ud-btn-primary"><i class="bi bi-plus-lg"></i> New Booking</a>
                <a href="/events" class="ud-btn ud-btn-outline"><i class="bi bi-gift"></i> Book Event</a>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="row g-3 mb-3">
            <div class="col-lg-3 col-md-6">
                <div class="ud-stat">
                    <div class="ud-stat-icon ud-icon-terracotta"><i class="bi bi-building"></i></div>
                    <div>
                        <div class="ud-stat-value">@hotelBookings.Count()</div>
                        <div class="ud-stat-label">Hotel Bookings</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="ud-stat">
                    <div class="ud-stat-icon ud-icon-olive"><i class="bi bi-calendar-event"></i></div>
                    <div>
                        <div class="ud-stat-value">@eventBookings.Count()</div>
                        <div class="ud-stat-label">Event Bookings</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="ud-stat">
                    <div class="ud-stat-icon ud-icon-teal"><i class="bi bi-wallet2"></i></div>
                    <div>
                        <div class="ud-stat-value">KES @GetTotalSpend().ToString("N0")</div>
                        <div class="ud-stat-label">Total Spent</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="ud-stat">
                    <div class="ud-stat-icon ud-icon-bronze"><i class="bi bi-clock-history"></i></div>
                    <div>
                        <div class="ud-stat-value">@GetPendingCount()</div>
                        <div class="ud-stat-label">Pending</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upcoming Booking Highlight -->
        var nextBooking = GetNextUpcomingBooking();
        @if (nextBooking != null)
        {
            <div class="ud-upcoming mb-3">
                <div class="ud-upcoming-label"><i class="bi bi-lightning-fill"></i> UPCOMING</div>
                <div class="ud-upcoming-body">
                    <div class="ud-upcoming-info">
                        <span class="ud-upcoming-name">@nextBooking.Hotel?.Name</span>
                        <span class="ud-upcoming-meta">@nextBooking.StartDate.ToString("MMM dd") – @nextBooking.EndDate.ToString("MMM dd, yyyy") · @nextBooking.HeadCount guests</span>
                    </div>
                    <div class="ud-upcoming-countdown">
                        <span class="ud-countdown-value">@((nextBooking.StartDate - DateTime.Now).Days)</span>
                        <span class="ud-countdown-label">days away</span>
                    </div>
                </div>
            </div>
        }

        <!-- Main Row: 8:4 layout -->
        <div class="row g-3">
            <!-- Left Column: Tabbed Bookings -->
            <div class="col-lg-8">
                <div class="ud-card">
                    <div class="ud-tab-bar">
                        <button class="ud-tab @(activeTab == "hotels" ? "ud-tab-active" : "")" @onclick='() => activeTab = "hotels"'>
                            <i class="bi bi-building"></i> Hotel Bookings
                            <span class="ud-tab-count">@hotelBookings.Count()</span>
                        </button>
                        <button class="ud-tab @(activeTab == "events" ? "ud-tab-active" : "")" @onclick='() => activeTab = "events"'>
                            <i class="bi bi-calendar-event"></i> Event Bookings
                            <span class="ud-tab-count">@eventBookings.Count()</span>
                        </button>
                        <div class="ud-tab-spacer"></div>
                        <a href="@(activeTab == "hotels" ? "/my-bookings" : "/my-event-bookings")" class="ud-link">View All <i class="bi bi-arrow-right"></i></a>
                    </div>
                    <div class="ud-card-body">
                        @if (activeTab == "hotels")
                        {
                            @if (hotelBookings.Any())
                            {
                                @foreach (var booking in hotelBookings.Take(5))
                                {
                                    <div class="ud-row" @onclick="() => ViewHotelBooking(booking.Id)">
                                        <div class="ud-row-left">
                                            <span class="ud-row-name">@booking.Hotel?.Name</span>
                                            <span class="ud-row-meta">@booking.StartDate.ToString("MMM dd") – @booking.EndDate.ToString("MMM dd") · @booking.HeadCount guests · @((booking.EndDate - booking.StartDate).Days) nights</span>
                                            <span class="ud-badge ud-badge-@(booking.Status == BookingStatus.Confirmed ? "ok" : booking.Status == BookingStatus.Pending ? "warn" : "muted")">@booking.Status</span>
                                        </div>
                                        <div class="ud-row-right">
                                            <span class="ud-row-amount">KES @CalculateBookingTotal(booking).ToString("N0")</span>
                                            <i class="bi bi-chevron-right ud-chevron"></i>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <EmptyState 
                                    Icon="building"
                                    Title="No hotel bookings yet"
                                    Description="Start exploring amazing hotels and make your first booking!"
                                    ActionText="Browse Hotels"
                                    ActionIcon="search"
                                    OnActionClick="@(() => Navigation.NavigateTo("/search"))" />
                            }
                        }
                        else
                        {
                            @if (eventBookings.Any())
                            {
                                @foreach (var booking in eventBookings.Take(5))
                                {
                                    <div class="ud-row" @onclick="() => ViewEventBooking(booking.Id)">
                                        <div class="ud-row-left">
                                            <span class="ud-row-name">@booking.EventName</span>
                                            <span class="ud-row-meta">@booking.EventDate.ToString("MMM dd, yyyy") · @booking.ExpectedGuests guests · @booking.Venue</span>
                                            <span class="ud-badge ud-badge-@(booking.Status == EventBookingStatus.Confirmed ? "ok" : booking.Status == EventBookingStatus.Pending ? "warn" : "muted")">@booking.Status</span>
                                        </div>
                                        <div class="ud-row-right">
                                            <span class="ud-row-amount">KES @booking.TotalAmount.ToString("N0")</span>
                                            <i class="bi bi-chevron-right ud-chevron"></i>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <EmptyState 
                                    Icon="calendar-event"
                                    Title="No event bookings yet"
                                    Description="Discover amazing event packages for your special occasions!"
                                    ActionText="Browse Event Packages"
                                    ActionIcon="gift"
                                    OnActionClick="@(() => Navigation.NavigateTo("/events"))" />
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Quick Action Cards -->
            <div class="col-lg-4">
                <div class="ud-qaction-stack">
                    <a href="/search" class="ud-qaction">
                        <div class="ud-qaction-icon ud-icon-terracotta"><i class="bi bi-search"></i></div>
                        <span class="ud-qaction-text">Search Hotels</span>
                        <i class="bi bi-arrow-right ud-qaction-arrow"></i>
                    </a>
                    <a href="/events" class="ud-qaction">
                        <div class="ud-qaction-icon ud-icon-olive"><i class="bi bi-gift"></i></div>
                        <span class="ud-qaction-text">Event Packages</span>
                        <i class="bi bi-arrow-right ud-qaction-arrow"></i>
                    </a>
                    <a href="/my-bookings" class="ud-qaction">
                        <div class="ud-qaction-icon ud-icon-teal"><i class="bi bi-calendar-check"></i></div>
                        <span class="ud-qaction-text">My Bookings</span>
                        <i class="bi bi-arrow-right ud-qaction-arrow"></i>
                    </a>
                    <a href="/my-event-bookings" class="ud-qaction">
                        <div class="ud-qaction-icon ud-icon-bronze"><i class="bi bi-calendar2-event"></i></div>
                        <span class="ud-qaction-text">Event Bookings</span>
                        <i class="bi bi-arrow-right ud-qaction-arrow"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* ── Shell ── */
    .ud-shell {
        padding: 1.5rem 2rem;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
        color: #18181b;
        background: #f4efe6;
        min-height: 100%;
    }

    /* ── Welcome Banner ── */
    .ud-welcome {
        background: #ffffff;
        border: 1px solid #e8e2d8;
        border-radius: 16px;
        padding: 1.25rem 1.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.75rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    }
    .ud-title {
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        color: #18181b;
        margin: 0 0 0.25rem;
    }
    .ud-subtitle {
        font-size: 0.82rem;
        color: #6b7280;
        margin: 0;
        font-weight: 500;
    }
    .ud-welcome-right {
        display: flex;
        gap: 0.75rem;
    }
    .ud-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1rem;
        border-radius: 10px;
        font-size: 0.78rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
        border: none;
    }
    .ud-btn-primary {
        background: #b86d26;
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(184, 109, 38, 0.25);
    }
    .ud-btn-primary:hover {
        background: #a25c1a;
        color: #ffffff;
        text-decoration: none;
        transform: translateY(-1px);
    }
    .ud-btn-outline {
        background: #faf7f2;
        color: #18181b;
        border: 1px solid #e8e2d8;
    }
    .ud-btn-outline:hover {
        background: #ffffff;
        border-color: #b86d26;
        color: #b86d26;
        text-decoration: none;
        transform: translateY(-1px);
    }

    /* ── Upcoming Booking ── */
    .ud-upcoming {
        background: #18181b;
        border-radius: 16px;
        padding: 1.35rem 1.75rem;
        color: #ffffff;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.1);
        position: relative;
        overflow: hidden;
    }
    .ud-upcoming::after {
        content: '\F4B4'; /* lightning icon */
        font-family: 'Bootstrap-icons';
        position: absolute;
        right: -20px;
        bottom: -40px;
        font-size: 8rem;
        color: rgba(184, 109, 38, 0.12);
        pointer-events: none;
    }
    .ud-upcoming-label {
        font-size: 0.68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #e59a4c;
        margin-bottom: 0.5rem;
    }
    .ud-upcoming-body {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }
    .ud-upcoming-name {
        display: block;
        font-size: 1.15rem;
        font-weight: 800;
        color: #ffffff;
    }
    .ud-upcoming-meta {
        display: block;
        font-size: 0.82rem;
        color: #a1a1aa;
        margin-top: 0.25rem;
    }
    .ud-upcoming-countdown {
        text-align: center;
        flex-shrink: 0;
    }
    .ud-countdown-value {
        display: block;
        font-size: 2rem;
        font-weight: 800;
        color: #e59a4c;
        line-height: 1;
    }
    .ud-countdown-label {
        display: block;
        font-size: 0.68rem;
        color: #a1a1aa;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.25rem;
    }

    /* ── Stat Cards ── */
    .ud-stat {
        background: #ffffff;
        border: 1px solid #e8e2d8;
        border-radius: 16px;
        padding: 1.15rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: all 0.2s ease;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
        position: relative;
        overflow: hidden;
    }
    .ud-stat::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: #e8e2d8;
    }
    .row > div:nth-child(1) > .ud-stat::before { background: #b86d26; }
    .row > div:nth-child(2) > .ud-stat::before { background: #7c3aed; }
    .row > div:nth-child(3) > .ud-stat::before { background: #16a34a; }
    .row > div:nth-child(4) > .ud-stat::before { background: #0284c7; }
    
    .ud-stat:hover {
        transform: translateY(-2px);
        border-color: #b86d26;
        box-shadow: 0 8px 24px rgba(184, 109, 38, 0.12);
    }

    .ud-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }
    .ud-icon-terracotta { background: rgba(184, 109, 38, 0.12); color: #b86d26; }
    .ud-icon-olive { background: rgba(124, 58, 237, 0.12); color: #7c3aed; }
    .ud-icon-teal { background: rgba(22, 163, 74, 0.12); color: #16a34a; }
    .ud-icon-bronze { background: rgba(2, 132, 199, 0.12); color: #0284c7; }

    .ud-stat-value {
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        color: #18181b;
        line-height: 1.1;
    }
    .ud-stat-label {
        font-size: 0.72rem;
        color: #6b7280;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-top: 0.25rem;
    }

    /* ── Cards ── */
    .ud-card {
        background: #ffffff;
        border: 1px solid #e8e2d8;
        border-radius: 18px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }
    .ud-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.35rem;
        border-bottom: 1px solid #f4efe6;
    }
    .ud-card-title {
        font-size: 0.95rem;
        font-weight: 800;
        color: #18181b;
    }
    .ud-link {
        font-size: 0.78rem;
        font-weight: 700;
        color: #b86d26;
        text-decoration: none;
        letter-spacing: 0.01em;
    }
    .ud-link:hover { text-decoration: underline; color: #a25c1a; }
    .ud-card-body { padding: 0; }

    /* ── Tab Bar ── */
    .ud-tab-bar {
        display: flex;
        align-items: center;
        gap: 0;
        padding: 0 1.25rem;
        border-bottom: 1px solid #f4efe6;
    }
    .ud-tab {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.9rem 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: #6b7280;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }
    .ud-tab:hover { color: #18181b; }
    .ud-tab-active {
        color: #18181b;
        font-weight: 800;
        border-bottom-color: #b86d26;
    }
    .ud-tab-count {
        font-size: 0.68rem;
        font-weight: 700;
        background: #f4efe6;
        color: #18181b;
        padding: 0.1rem 0.45rem;
        border-radius: 10px;
        min-width: 1.35rem;
        text-align: center;
    }
    .ud-tab-active .ud-tab-count {
        background: rgba(184, 109, 38, 0.15);
        color: #b86d26;
    }
    .ud-tab-spacer { flex: 1; }

    /* ── Booking Rows ── */
    .ud-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.35rem;
        border-bottom: 1px solid #f4efe6;
        cursor: pointer;
        transition: background 0.15s ease;
    }
    .ud-row:last-child { border-bottom: none; }
    .ud-row:hover { background: #faf7f2; }
    .ud-row-left {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 0;
        flex: 1;
    }
    .ud-row-name {
        font-size: 0.92rem;
        font-weight: 700;
        color: #18181b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .ud-row-meta {
        font-size: 0.78rem;
        color: #6b7280;
        font-weight: 400;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .ud-row-right {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-shrink: 0;
        margin-left: 1rem;
    }
    .ud-row-amount {
        font-size: 0.95rem;
        font-weight: 800;
        color: #18181b;
    }
    .ud-chevron {
        font-size: 0.75rem;
        color: #b86d26;
    }

    /* ── Badges ── */
    .ud-badge {
        display: inline-block;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        margin-top: 0.25rem;
        width: fit-content;
    }
    .ud-badge-ok { background: rgba(22, 163, 74, 0.12); color: #16a34a; }
    .ud-badge-warn { background: rgba(184, 109, 38, 0.12); color: #b86d26; }
    .ud-badge-muted { background: rgba(107, 114, 128, 0.1); color: #6b7280; }

    /* ── Quick Action Cards ── */
    .ud-qaction-stack {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .ud-qaction {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        background: #ffffff;
        border: 1px solid #e8e2d8;
        border-radius: 14px;
        padding: 1rem 1.15rem;
        text-decoration: none;
        color: #18181b;
        transition: all 0.2s ease;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    }
    .ud-qaction:hover {
        transform: translateY(-2px);
        border-color: #b86d26;
        color: #b86d26;
        background: #faf7f2;
        box-shadow: 0 8px 24px rgba(184, 109, 38, 0.12);
        text-decoration: none;
    }

    .ud-qaction-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }
    .ud-qaction-text {
        flex: 1;
        font-size: 0.88rem;
        font-weight: 700;
    }
    .ud-qaction-arrow {
        font-size: 0.85rem;
        color: #b86d26;
        transition: transform 0.2s ease;
    }
    .ud-qaction:hover .ud-qaction-arrow {
        transform: translateX(4px);
    }
</style>

@code {
    private bool isLoading = true;
    private string activeTab = "hotels";
    private List<Booking> hotelBookings = new();
    private List<EventBooking> eventBookings = new();
    private List<UserMessage> messages = new();
    private string? currentUserId;

    private List<BreadcrumbItem> breadcrumbItems = new()
    {
        new BreadcrumbItem { Text = "Home", Url = "/" },
        new BreadcrumbItem { Text = "Dashboard", IsActive = true }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDashboardData();
            StateHasChanged();
        }
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        try
        {
            currentUserId = await GetCurrentUserIdAsync();
            if (!string.IsNullOrEmpty(currentUserId))
            {
                // Load hotel bookings from database
                hotelBookings = (await BookingService.GetBookingsByUserAsync(currentUserId)).ToList();
                
                // Load event bookings from database
                eventBookings = (await EventService.GetBookingsByUserAsync(currentUserId)).ToList();
            }
            else
            {
                hotelBookings = new List<Booking>();
                eventBookings = new List<EventBooking>();
            }
        }
        catch (Exception)
        {
            ToastService.ShowError("Error", "Failed to load dashboard data");
        }
        finally
        {
            isLoading = false;
        }
    }

    private int GetPendingCount()
    {
        return hotelBookings.Count(b => b.Status == BookingStatus.Pending) +
               eventBookings.Count(b => b.Status == EventBookingStatus.Pending);
    }

    private decimal GetTotalSpend()
    {
        var hotelTotal = hotelBookings.Sum(b => CalculateBookingTotal(b));
        var eventTotal = eventBookings.Sum(b => b.TotalAmount);
        return hotelTotal + eventTotal;
    }

    private Booking? GetNextUpcomingBooking()
    {
        return hotelBookings
            .Where(b => b.StartDate > DateTime.Now)
            .OrderBy(b => b.StartDate)
            .FirstOrDefault();
    }

    private string GetStatusBadgeClass(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending => "badge-gradient-warning",
            BookingStatus.Confirmed => "badge-gradient-success",
            BookingStatus.Rejected => "badge-gradient-danger",
            BookingStatus.Cancelled => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private string GetEventStatusBadgeClass(EventBookingStatus status)
    {
        return status switch
        {
            EventBookingStatus.Pending => "badge-gradient-warning",
            EventBookingStatus.Confirmed => "badge-gradient-success",
            EventBookingStatus.Completed => "badge-gradient-info",
            EventBookingStatus.Cancelled => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private async Task<string?> GetCurrentUserIdAsync()
    {
        try
        {
            string? token = null;
            try { token = await JSRuntime.InvokeAsync<string>("authHelpers.getCookie", "JWToken"); } catch { }
            if (!string.IsNullOrEmpty(token))
            {
                var customAuth = (CustomAuthenticationStateProvider)AuthStateProvider;
                await customAuth.MarkUserAsAuthenticated(token);
            }
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState?.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                var nameClaim = user.FindFirst(ClaimTypes.Name)?.Value;
                if (!string.IsNullOrEmpty(nameClaim))
                {
                    var parts = nameClaim.Split(',');
                    if (parts.Length > 0) return parts[0];
                }
            }
        }
        catch { }
        return null;
    }

