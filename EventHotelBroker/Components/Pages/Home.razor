@page "/"
@layout EventHotelBroker.Components.Layout.HomeLayout
@rendermode InteractiveServer
@using EventHotelBroker.Services
@using EventHotelBroker.Models
@inject IHotelService HotelService
@inject IEventService EventService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Home - Safari Vents</PageTitle>

<!-- Modern Luxury Hero Section -->
<div class="modern-hero">
    <div class="hero-background"></div>
    <div class="hero-content">
        <div class="container">
            <div class="row align-items-center g-5">
                <!-- Left Column: Branding, Title, Multi-Field Search, Trust -->
                <div class="col-lg-6 animate-fade-in">
                    <div class="hero-brand-pill">
                        <span class="pill-dot"></span>
                        <span class="pill-text">Kenya's Premier Venue & Event Broker</span>
                    </div>
                    
                    <h1 class="hero-title">
                        Find Exceptional Venues<br />
                        <span class="highlight-copper">For Any Event.</span>
                    </h1>
                    
                    <p class="hero-subtitle">
                        From iconic Nairobi luxury hotels and lush Naivasha wedding gardens to coastal Diani retreats and pro audio-visual rentals. Book directly with verified Kenyan hosts.
                    </p>

                    <!-- Multi-Field Interactive Booking Search -->
                    <div class="hero-search-card">
                        <div class="hero-search-grid">
                            <div class="search-field">
                                <label class="field-label"><i class="bi bi-geo-alt-fill text-copper"></i> Destination</label>
                                <select class="field-control" @bind="searchLocation">
                                    <option value="">All Kenya</option>
                                    <option value="Nairobi">Nairobi</option>
                                    <option value="Mombasa">Mombasa / Diani</option>
                                    <option value="Naivasha">Naivasha</option>
                                    <option value="Nakuru">Nakuru</option>
                                    <option value="Kisumu">Kisumu</option>
                                    <option value="Eldoret">Eldoret</option>
                                    <option value="Nanyuki">Nanyuki</option>
                                </select>
                            </div>
                            <div class="field-divider"></div>
                            <div class="search-field">
                                <label class="field-label"><i class="bi bi-building text-copper"></i> Venue Type</label>
                                <select class="field-control" @bind="searchCategory">
                                    <option value="">All Categories</option>
                                    <option value="Hotel">Hotels & Resorts</option>
                                    <option value="Airbnb">Airbnb & Villas</option>
                                    <option value="Restaurant">Restaurants & Lounges</option>
                                    <option value="Package">Event Packages</option>
                                    <option value="Equipment">Sound & Stage Rental</option>
                                </select>
                            </div>
                            <div class="field-divider"></div>
                            <div class="search-field">
                                <label class="field-label"><i class="bi bi-people-fill text-copper"></i> Guests</label>
                                <select class="field-control" @bind="searchCapacity">
                                    <option value="">Any Size</option>
                                    <option value="50">Up to 50</option>
                                    <option value="200">50 - 200</option>
                                    <option value="500">200 - 500</option>
                                    <option value="1000">500+</option>
                                </select>
                            </div>
                            <button type="button" class="btn-hero-search" @onclick="ExecuteHeroSearch">
                                <i class="bi bi-search"></i>
                                <span>Search</span>
                            </button>
                        </div>
                    </div>

                    <!-- Trending Destination Tags -->
                    <div class="hero-quick-tags">
                        <span class="quick-tags-label">Trending:</span>
                        <button type="button" class="quick-tag-pill" @onclick='() => QuickSearch("Nairobi")'>Nairobi</button>
                        <button type="button" class="quick-tag-pill" @onclick='() => QuickSearch("Mombasa")'>Mombasa</button>
                        <button type="button" class="quick-tag-pill" @onclick='() => QuickSearch("Naivasha")'>Naivasha</button>
                        <button type="button" class="quick-tag-pill" @onclick='() => QuickFilterCategory("Hotel")'>Hotels</button>
                        <button type="button" class="quick-tag-pill" @onclick='() => QuickFilterCategory("Airbnb")'>Villas</button>
                    </div>

                    <!-- Trust Stats Bar -->
                    <div class="hero-trust-bar">
                        <div class="trust-item">
                            <div class="trust-num">500+</div>
                            <div class="trust-lbl">Verified Venues</div>
                        </div>
                        <div class="trust-divider"></div>
                        <div class="trust-item">
                            <div class="trust-num">10K+</div>
                            <div class="trust-lbl">Events Hosted</div>
                        </div>
                        <div class="trust-divider"></div>
                        <div class="trust-item">
                            <div class="trust-num">4.9â˜…</div>
                            <div class="trust-lbl">Host Rating</div>
                        </div>
                        <div class="trust-divider"></div>
                        <div class="trust-item">
                            <div class="trust-num">100%</div>
                            <div class="trust-lbl">M-PESA Secure</div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Visual Kenyan Venue Showcase (Fills the entire right side) -->
                <div class="col-lg-6 d-none d-lg-block">
                    <div class="hero-visual-wrapper">
                        <!-- Main Showcase Card -->
                        @if (featuredHotels?.Any() == true)
                        {
                            var topHotel = featuredHotels.First();
                            var heroImg = topHotel.Images?.FirstOrDefault()?.Url ?? "/uploads/hotels/1_009d1e80674a4c7f9d338e68aa93eb85.jpg";
                            <a href="/hotels/@topHotel.Id" class="hero-featured-card">
                                <div class="featured-card-media">
                                    <img src="@heroImg" alt="@topHotel.Name" class="featured-img" onerror="this.src='/uploads/hotels/1_009d1e80674a4c7f9d338e68aa93eb85.jpg'" />
                                    <div class="badge-featured-verified">
                                        <i class="bi bi-patch-check-fill"></i> Verified Partner
                                    </div>
                                    <div class="badge-featured-rating">
                                        <i class="bi bi-star-fill"></i> 4.9 (142)
                                    </div>
                                    <div class="featured-card-scrim">
                                        <div class="featured-venue-meta">
                                            <span class="venue-badge-cat">@(topHotel.Category ?? "Luxury Venue")</span>
                                            <h3 class="venue-badge-title">@topHotel.Name</h3>
                                            <p class="venue-badge-location"><i class="bi bi-geo-alt-fill text-copper"></i> @topHotel.City, @topHotel.Country</p>
                                        </div>
                                        <div class="featured-venue-price">
                                            <span class="price-prefix">From</span>
                                            <span class="price-val">@topHotel.Currency @topHotel.PricePerNight.ToString("N0")</span>
                                            <span class="price-unit">/night</span>
                                        </div>
                                    </div>
                                </div>
                            </a>

                            @if (featuredHotels.Count > 1)
                            {
                                var subHotel = featuredHotels.Skip(1).First();
                                var subImg = subHotel.Images?.FirstOrDefault()?.Url ?? "/uploads/hotels/1_19ac5448be1f47669ad686844f1a5722.jpg";
                                <a href="/hotels/@subHotel.Id" class="hero-floating-subcard">
                                    <img src="@subImg" alt="@subHotel.Name" class="sub-card-img" onerror="this.src='/uploads/hotels/1_19ac5448be1f47669ad686844f1a5722.jpg'" />
                                    <div class="sub-card-info">
                                        <div class="sub-card-cat">@(subHotel.Category ?? "Featured")</div>
                                        <div class="sub-card-title">@subHotel.Name</div>
                                        <div class="sub-card-price">@subHotel.Currency @subHotel.PricePerNight.ToString("N0") <span class="sub-unit">/night</span></div>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <!-- Default Fallback Showcase -->
                            <a href="/search" class="hero-featured-card">
                                <div class="featured-card-media">
                                    <img src="/uploads/hotels/1_009d1e80674a4c7f9d338e68aa93eb85.jpg" alt="Villa Rosa Kempinski" class="featured-img" />
                                    <div class="badge-featured-verified">
                                        <i class="bi bi-patch-check-fill"></i> Verified Partner
                                    </div>
                                    <div class="badge-featured-rating">
                                        <i class="bi bi-star-fill"></i> 4.9 (142)
                                    </div>
                                    <div class="featured-card-scrim">
                                        <div class="featured-venue-meta">
                                            <span class="venue-badge-cat">5-Star Luxury Hotel</span>
                                            <h3 class="venue-badge-title">Villa Rosa Kempinski</h3>
                                            <p class="venue-badge-location"><i class="bi bi-geo-alt-fill text-copper"></i> Chiromo Rd, Westlands, Nairobi</p>
                                        </div>
                                        <div class="featured-venue-price">
                                            <span class="price-prefix">From</span>
                                            <span class="price-val">KES 45,000</span>
                                            <span class="price-unit">/night</span>
                                        </div>
                                    </div>
                                </div>
                            </a>

                            <a href="/search?q=Diani" class="hero-floating-subcard">
                                <img src="/uploads/hotels/1_19ac5448be1f47669ad686844f1a5722.jpg" alt="Diani Beach Resort" class="sub-card-img" />
                                <div class="sub-card-info">
                                    <div class="sub-card-cat">Beachfront Resort</div>
                                    <div class="sub-card-title">Diani Reef Resort</div>
                                    <div class="sub-card-price">KES 32,000 <span class="sub-unit">/night</span></div>
                                </div>
                            </a>
                        }

                        <!-- Floating Instant M-PESA Confirmation Badge -->
                        <div class="hero-floating-pill pill-instant">
                            <div class="pill-icon-circle green">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div class="pill-text-block">
                                <div class="pill-main">Instant Booking</div>
                                <div class="pill-sub">Lipa na M-PESA & Card</div>
                            </div>
                        </div>

                        <!-- Floating Host Chat Pill -->
                        <div class="hero-floating-pill pill-chat">
                            <div class="pill-icon-circle copper">
                                <i class="bi bi-chat-heart-fill"></i>
                            </div>
                            <div class="pill-text-block">
                                <div class="pill-main">Direct Host Chat</div>
                                <div class="pill-sub">Fast reply & custom quotes</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Curated Categories Explorer Strip -->
<div class="categories-strip-section">
    <div class="container">
        <div class="section-header-compact text-center mb-4">
            <span class="section-badge">Explore Categories</span>
            <h2 class="section-title">Find Venues by Event Type</h2>
            <p class="section-subtitle">Tailored spaces for weddings, summits, private parties, and retreats</p>
        </div>
        <div class="row g-3">
            <div class="col-6 col-md-4 col-lg-2">
                <a href="/search?category=Hotel" class="category-strip-card">
                    <div class="category-icon-wrap"><i class="bi bi-building"></i></div>
                    <span class="category-name">Hotels & Resorts</span>
                    <span class="category-sub">120+ venues</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a href="/search?category=Airbnb" class="category-strip-card">
                    <div class="category-icon-wrap"><i class="bi bi-house"></i></div>
                    <span class="category-name">Airbnb & Villas</span>
                    <span class="category-sub">85+ spaces</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a href="/search?q=Lodge" class="category-strip-card">
                    <div class="category-icon-wrap"><i class="bi bi-tree"></i></div>
                    <span class="category-name">Safari Lodges</span>
                    <span class="category-sub">40+ retreats</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a href="/search?category=Restaurant" class="category-strip-card">
                    <div class="category-icon-wrap"><i class="bi bi-cup-hot"></i></div>
                    <span class="category-name">Restaurants</span>
                    <span class="category-sub">65+ places</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a href="/events" class="category-strip-card">
                    <div class="category-icon-wrap"><i class="bi bi-gift"></i></div>
                    <span class="category-name">Event Packages</span>
                    <span class="category-sub">Bundled deals</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a href="/events?tab=equipment" class="category-strip-card">
                    <div class="category-icon-wrap"><i class="bi bi-speaker"></i></div>
                    <span class="category-name">Audio & Lighting</span>
                    <span class="category-sub">Sound & stage</span>
                </a>
            </div>
        </div>
    </div>
</div>


<!-- How It Works Section -->
<div class="how-it-works-section">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-badge">Simple Process</span>
            <h2 class="section-title">How It Works</h2>
            <p class="section-subtitle">Book your perfect venue in three easy steps</p>
        </div>
        <div class="row g-2 g-md-3 g-lg-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-number">01</div>
                    <div class="feature-icon">
                        <i class="bi bi-search"></i>
                    </div>
                    <h5 class="feature-title">Search & Discover</h5>
                    <p class="feature-text">Browse through hundreds of verified venues and service providers in your area.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-number">02</div>
                    <div class="feature-icon">
                        <i class="bi bi-chat-dots"></i>
                    </div>
                    <h5 class="feature-title">Connect & Inquire</h5>
                    <p class="feature-text">Message venue owners directly and get instant responses to your questions.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-number">03</div>
                    <div class="feature-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <h5 class="feature-title">Book with Confidence</h5>
                    <p class="feature-text">Send booking requests and manage everything from your dashboard.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Explore Hotels & Events Section with Tabs -->
<div class="explore-section py-5">
    <div class="container">
        <div class="section-header text-center mb-4">
            <span class="section-badge">Explore Our Services</span>
            <h2 class="section-title">Hotels & Event Packages</h2>
            <p class="section-subtitle">Everything you need for your perfect event in one place</p>
        </div>

        <!-- Modern Tabs -->
        <div class="modern-tabs-container mb-4">
            <div class="modern-tabs" style="display:inline-flex;">
                <button id="tabBtnAllHotels" class="nav-link active" type="button"
                        onclick="switchTab('all-hotels');this.classList.add('active');document.getElementById('tabBtnHotels').classList.remove('active');document.getElementById('tabBtnAirbnb').classList.remove('active');document.getElementById('tabBtnRestaurant').classList.remove('active');document.getElementById('tabBtnEvents').classList.remove('active');document.getElementById('tabBtnEquipment').classList.remove('active');">
                    <i class="bi bi-building me-2"></i>
                    <span>All Hotels</span>
                    <span class="tab-count">@(featuredHotels?.Count ?? 0)</span>
                </button>
                <button id="tabBtnHotels" class="nav-link" type="button"
                        onclick="switchTab('hotels');this.classList.add('active');document.getElementById('tabBtnAllHotels').classList.remove('active');document.getElementById('tabBtnAirbnb').classList.remove('active');document.getElementById('tabBtnRestaurant').classList.remove('active');document.getElementById('tabBtnEvents').classList.remove('active');document.getElementById('tabBtnEquipment').classList.remove('active');">
                    <i class="bi bi-building me-2"></i>
                    <span>Hotels</span>
                    <span class="tab-count">@(featuredHotels?.Count(h => h.Category == "Hotel") ?? 0)</span>
                </button>
                <button id="tabBtnAirbnb" class="nav-link" type="button"
                        onclick="switchTab('airbnb');this.classList.add('active');document.getElementById('tabBtnAllHotels').classList.remove('active');document.getElementById('tabBtnHotels').classList.remove('active');document.getElementById('tabBtnRestaurant').classList.remove('active');document.getElementById('tabBtnEvents').classList.remove('active');document.getElementById('tabBtnEquipment').classList.remove('active');">
                    <i class="bi bi-house me-2"></i>
                    <span>Airbnb</span>
                    <span class="tab-count">@(featuredHotels?.Count(h => h.Category == "Airbnb") ?? 0)</span>
                </button>
                <button id="tabBtnRestaurant" class="nav-link" type="button"
                        onclick="switchTab('restaurant');this.classList.add('active');document.getElementById('tabBtnAllHotels').classList.remove('active');document.getElementById('tabBtnHotels').classList.remove('active');document.getElementById('tabBtnAirbnb').classList.remove('active');document.getElementById('tabBtnEvents').classList.remove('active');document.getElementById('tabBtnEquipment').classList.remove('active');">
                    <i class="bi bi-cup-hot me-2"></i>
                    <span>Restaurants</span>
                    <span class="tab-count">@(featuredHotels?.Count(h => h.Category == "Restaurant") ?? 0)</span>
                </button>
                <button id="tabBtnEvents" class="nav-link" type="button"
                        onclick="switchTab('events');this.classList.add('active');document.getElementById('tabBtnAllHotels').classList.remove('active');document.getElementById('tabBtnHotels').classList.remove('active');document.getElementById('tabBtnAirbnb').classList.remove('active');document.getElementById('tabBtnRestaurant').classList.remove('active');document.getElementById('tabBtnEquipment').classList.remove('active');">
                    <i class="bi bi-gift me-2"></i>
                    <span>Event Packages</span>
                    <span class="tab-count">@(featuredPackages?.Count ?? 0)</span>
                </button>
                <button id="tabBtnEquipment" class="nav-link" type="button"
                        onclick="switchTab('equipment');this.classList.add('active');document.getElementById('tabBtnAllHotels').classList.remove('active');document.getElementById('tabBtnHotels').classList.remove('active');document.getElementById('tabBtnAirbnb').classList.remove('active');document.getElementById('tabBtnRestaurant').classList.remove('active');document.getElementById('tabBtnEvents').classList.remove('active');">
                    <i class="bi bi-box-seam me-2"></i>
                    <span>Equipment Rental</span>
                    <span class="tab-count">@(featuredEquipments?.Count ?? 0)</span>
                </button>
            </div>
        </div>

        <!-- Tab Content -->
        <div class="tab-content">
            <!-- All Hotels Tab -->
            <div id="tabAllHotels" class="tab-pane-content">
                @if (featuredHotels == null)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border spinner-modern text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 text-muted">Loading venues...</p>
                    </div>
                }
                else if (!featuredHotels.Any())
                {
                    <div class="modern-card">
                        <div class="empty-state">
                            <i class="bi bi-building empty-state-icon"></i>
                            <h3 class="empty-state-title">No Venues Available</h3>
                            <p class="empty-state-text">Check back soon for amazing venues!</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-2 g-md-3 g-lg-4">
                        @foreach (var hotel in featuredHotels.Take(6))
                        {
                            <div class="col-6 col-md-6 col-lg-3">
                                <a href="/hotels/@hotel.Id" class="hotel-card" style="text-decoration:none;color:inherit;display:block;">
                                    <div class="hotel-image">
                                        @if (hotel.Images?.Any() == true)
                                        {
                                            <img src="@hotel.Images.First().Url" alt="@hotel.Name" />
                                        }
                                        else
                                        {
                                            <div class="hotel-placeholder">
                                                <i class="bi bi-building"></i>
                                            </div>
                                        }
                                        @if (hotel.IsApproved)
                                        {
                                            <div class="hotel-badge">
                                                <i class="bi bi-patch-check-fill"></i>
                                                <span>Verified</span>
                                            </div>
                                        }
                                        <div class="hotel-category-badge">
                                            <i class="bi @GetCategoryIcon(hotel.Category)"></i>
                                            <span>@hotel.Category</span>
                                        </div>
                                        <div class="hotel-overlay">
                                            <span class="hotel-view-btn">
                                                <i class="bi bi-eye me-2"></i>View Details
                                            </span>
                                        </div>
                                    </div>
                                    <div class="hotel-content">
                                        <h5 class="hotel-name">@hotel.Name</h5>
                                        <span class="hotel-location"><i class="bi bi-geo-alt-fill"></i> @hotel.City, @hotel.Country</span>

                                        <div class="hotel-meta-row">
                                            <div class="hotel-rating">
                                                <i class="bi bi-star-fill"></i>
                                                <span class="hotel-rating-text">4.5</span>
                                            </div>
                                            <span class="meta-dot"></span>
                                            <div class="hotel-price-inline">
                                                <span class="price-amount">@hotel.Currency @hotel.PricePerNight.ToString("N0")</span>
                                                <span class="price-period">/night</span>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(hotel.Description))
                                        {
                                            <p class="hotel-description">@hotel.Description</p>
                                        }

                                        <div class="hotel-footer">
                                            <span class="hotel-book-btn">
                                                View <i class="bi bi-arrow-right"></i>
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                    <div class="text-center mt-4">
                        <a href="/search" class="btn-modern btn-gradient-primary">
                            <i class="bi bi-search me-2"></i>Explore All Hotels
                        </a>
                    </div>
                }
            </div>

            <!-- Hotels Category Tab (hidden by default) -->
            <div id="tabHotelsContent" class="tab-pane-content" style="display:none;">
                @if (featuredHotels == null)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border spinner-modern text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 text-muted">Loading hotels...</p>
                    </div>
                }
                else if (!filteredHotels.Any())
                {
                    <div class="modern-card">
                        <div class="empty-state">
                            <i class="bi bi-building empty-state-icon"></i>
                            <h3 class="empty-state-title">No Hotels Available</h3>
                            <p class="empty-state-text">Check back soon for amazing hotels!</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-2 g-md-3 g-lg-4">
                        @foreach (var hotel in filteredHotels.Take(6))
                        {
                            <div class="col-6 col-md-6 col-lg-3">
                                <a href="/hotels/@hotel.Id" class="hotel-card" style="text-decoration:none;color:inherit;display:block;">
                                    <div class="hotel-image">
                                        @if (hotel.Images?.Any() == true)
                                        {
                                            <img src="@hotel.Images.First().Url" alt="@hotel.Name" />
                                        }
                                        else
                                        {
                                            <div class="hotel-placeholder">
                                                <i class="bi bi-building"></i>
                                            </div>
                                        }
                                        @if (hotel.IsApproved)
                                        {
                                            <div class="hotel-badge">
                                                <i class="bi bi-patch-check-fill"></i>
                                                <span>Verified</span>
                                            </div>
                                        }
                                        <div class="hotel-category-badge">
                                            <i class="bi @GetCategoryIcon(hotel.Category)"></i>
                                            <span>@hotel.Category</span>
                                        </div>
                                        <div class="hotel-overlay">
                                            <span class="hotel-view-btn">
                                                <i class="bi bi-eye me-2"></i>View Details
                                            </span>
                                        </div>
                                    </div>
                                    <div class="hotel-content">
                                        <h5 class="hotel-name">@hotel.Name</h5>
                                        <span class="hotel-location"><i class="bi bi-geo-alt-fill"></i> @hotel.City, @hotel.Country</span>

                                        <div class="hotel-meta-row">
