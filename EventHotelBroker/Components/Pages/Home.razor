@code {
    private List<Hotel>? featuredHotels;
    private List<EventPackage>? featuredPackages;
    private List<EventEquipment>? featuredEquipments;
    private List<Hotel> filteredHotels = new();
    private string selectedCategory = "All";
    private string listVenueUrl = "/enroll-as-owner";
    private string searchQuery = "";
    private string searchLocation = "";
    private string searchCategory = "";
    private string searchCapacity = "";
    private DotNetObjectReference<Home>? objRef;

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ExecuteSearch();
        }
    }

    private void ExecuteSearch()
    {
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(searchQuery.Trim())}");
        }
        else
        {
            Navigation.NavigateTo("/search");
        }
    }

    private void ExecuteHeroSearch()
    {
        var queryParams = new List<string>();
        if (!string.IsNullOrWhiteSpace(searchLocation))
            queryParams.Add($"city={Uri.EscapeDataString(searchLocation)}");
        if (!string.IsNullOrWhiteSpace(searchCategory))
        {
            if (searchCategory == "Package")
            {
                Navigation.NavigateTo("/events");
                return;
            }
            if (searchCategory == "Equipment")
            {
                Navigation.NavigateTo("/events?tab=equipment");
                return;
            }
            queryParams.Add($"category={Uri.EscapeDataString(searchCategory)}");
        }
        if (!string.IsNullOrWhiteSpace(searchCapacity) && int.TryParse(searchCapacity, out var cap))
        {
            queryParams.Add($"capacity={cap}");
        }

        if (queryParams.Any())
            Navigation.NavigateTo($"/search?{string.Join("&", queryParams)}");
        else
            Navigation.NavigateTo("/search");
    }

    private void QuickSearch(string city)
    {
        Navigation.NavigateTo($"/search?city={Uri.EscapeDataString(city)}");
    }

    private void QuickFilterCategory(string category)
    {
        Navigation.NavigateTo($"/search?category={Uri.EscapeDataString(category)}");
    }

    private async Task HandleListVenueClick()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState?.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                var roleClaim = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
                    ?? user.FindFirst("AccountType")?.Value 
                    ?? "";

                if (roleClaim.Contains("HotelOwner", StringComparison.OrdinalIgnoreCase) || 
                    roleClaim.Contains("Admin", StringComparison.OrdinalIgnoreCase))
                {
                    Navigation.NavigateTo("/owner/create-hotel");
                }
                else
                {
                    Navigation.NavigateTo("/enroll-as-owner");
                }
            }
            else
            {
                Navigation.NavigateTo("/login?ReturnUrl=/enroll-as-owner");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error navigating to list venue: {ex.Message}");
            Navigation.NavigateTo("/enroll-as-owner");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load hotels
            var hotels = await HotelService.GetPublishedHotelsAsync();
            featuredHotels = hotels.ToList();
            filteredHotels = featuredHotels.ToList();
            
            // Load featured event packages
            var allPackages = await EventService.GetApprovedPackagesAsync();
            featuredPackages = allPackages.Where(p => p.IsFeatured || p.IsActive).Take(6).ToList();

            // Load featured equipment
            var allEquipments = await EventService.GetAllEquipmentsAsync();
            featuredEquipments = allEquipments.Where(e => e.IsApproved && e.IsAvailable).Take(8).ToList();
            
            // Check auth state for venue button
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? user.FindFirst("AccountType")?.Value ?? "";
                if (role.Contains("HotelOwner", StringComparison.OrdinalIgnoreCase) || role.Contains("Admin", StringComparison.OrdinalIgnoreCase))
                {
                    listVenueUrl = "/owner/create-hotel";
                }
            }
        }
        catch
        {
            featuredHotels = new List<Hotel>();
            filteredHotels = new List<Hotel>();
            featuredPackages = new List<EventPackage>();
            featuredEquipments = new List<EventEquipment>();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                objRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("homeHelpers.init", objRef);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing home helpers: {ex.Message}");
            }
        }
    }

    [JSInvokable]
    public async Task SwitchTab(string tabName)
    {
        // Hide all tabs
        await JSRuntime.InvokeVoidAsync("eval", @"
            document.getElementById('tabAllHotels').style.display = 'none';
            document.getElementById('tabHotelsContent').style.display = 'none';
            document.getElementById('tabAirbnbContent').style.display = 'none';
            document.getElementById('tabRestaurantContent').style.display = 'none';
            document.getElementById('tabEventsContent').style.display = 'none';
            document.getElementById('tabEquipmentContent').style.display = 'none';
        ");

        // Show selected tab and filter if needed
        switch (tabName)
        {
            case "all-hotels":
                await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('tabAllHotels').style.display = '';");
                break;
            case "hotels":
                selectedCategory = "Hotel";
                if (featuredHotels != null)
                {
                    filteredHotels = featuredHotels.Where(h => h.Category == "Hotel").ToList();
                }
                await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('tabHotelsContent').style.display = '';");
                break;
            case "airbnb":
                selectedCategory = "Airbnb";
                if (featuredHotels != null)
                {
                    filteredHotels = featuredHotels.Where(h => h.Category == "Airbnb").ToList();
                }
                await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('tabAirbnbContent').style.display = '';");
                break;
            case "restaurant":
                selectedCategory = "Restaurant";
                if (featuredHotels != null)
                {
                    filteredHotels = featuredHotels.Where(h => h.Category == "Restaurant").ToList();
                }
                await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('tabRestaurantContent').style.display = '';");
                break;
            case "events":
                await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('tabEventsContent').style.display = '';");
                break;
            case "equipment":
                await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('tabEquipmentContent').style.display = '';");
                break;
        }
        
        StateHasChanged();
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }

