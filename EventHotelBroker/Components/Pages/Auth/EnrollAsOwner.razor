@page "/enroll-as-owner"
@using EventHotelBroker.Services
@using EventHotelBroker.Utils
@using EventHotelBroker.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject TokenProvider TokenProvider
@inject IHttpContextAccessor HttpContextAccessor
@rendermode InteractiveServer

<PageTitle>Enroll as Business Owner - Safari Vents</PageTitle>

<div style="display:flex;justify-content:center;align-items:center;min-height:100vh;background:#f5eee6;padding:20px;font-family:var(--font-primary,'Plus Jakarta Sans',sans-serif);">
    <div style="background:white;border-radius:24px;padding:48px 40px;max-width:480px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,0.08);text-align:center;border:1px solid rgba(184,109,38,0.1);">
        <div style="width:80px;height:80px;background:#b86d26;border-radius:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;box-shadow:0 8px 24px rgba(184,109,38,0.35);">
            <i class="bi bi-shop" style="font-size:2.2rem;color:white;"></i>
        </div>

        @if (!done)
        {
            <h2 style="font-weight:800;color:#18181b;margin-bottom:8px;letter-spacing:-0.02em;">Become a Business Owner</h2>
            <p style="color:#6b7280;font-size:0.95rem;line-height:1.6;margin-bottom:32px;">
                List your hotels, venues, and equipment on Safari Vents and reach thousands of event planners and travelers.
            </p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div style="background:#fff5f5;border:1px solid #fed7d7;border-radius:10px;padding:14px 18px;margin-bottom:20px;color:#c53030;font-size:0.88rem;text-align:left;">
                    <i class="bi bi-exclamation-circle me-2"></i>@errorMessage
                </div>
            }

            <button @onclick="DoEnroll" disabled="@isLoading"
                style="width:100%;padding:16px;border:none;border-radius:12px;background:#b86d26;color:white;font-weight:700;font-size:1.02rem;cursor:pointer;box-shadow:0 6px 20px rgba(184,109,38,0.35);transition:all 0.2s;">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Enroll My Business Now
            </button>
            <a href="/" style="display:block;margin-top:16px;color:#6b7280;font-size:0.88rem;text-decoration:none;font-weight:600;">← Not now, go back</a>
        }
        else
        {
            <div>
                <div style="width:64px;height:64px;background:#d1fae5;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
                    <i class="bi bi-check-lg" style="font-size:2rem;color:#059669;"></i>
                </div>
                <h2 style="font-weight:800;color:#18181b;margin-bottom:8px;">You're Now an Owner!</h2>
                <p style="color:#6b7280;font-size:0.95rem;line-height:1.6;margin-bottom:28px;">
                    Your account has been upgraded. You can now create and manage your properties.
                    Redirecting you now...
                </p>
                <div style="width:100%;height:4px;background:#e5e7eb;border-radius:2px;overflow:hidden;">
                    <div style="height:100%;background:#b86d26;animation:progress 2s linear forwards;"></div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    @@keyframes progress { from { width: 0%; } to { width: 100%; } }
</style>

@code {
    [SupplyParameterFromQuery] public string? userId { get; set; }

    private bool isLoading = false;
    private bool done = false;
    private string errorMessage = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && string.IsNullOrEmpty(userId))
        {
            // Try to get userId from auth state
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            if (auth.User?.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login?ReturnUrl=/enroll-as-owner");
                return;
            }
            var nameClaim = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "";
            userId = nameClaim.Split(',').FirstOrDefault();
            StateHasChanged();
        }
    }

    private async Task DoEnroll()
    {
        if (string.IsNullOrEmpty(userId)) 
        { 
            Navigation.NavigateTo("/login?ReturnUrl=/enroll-as-owner");
            return; 
        }

        isLoading = true;
        StateHasChanged();

        var result = await AuthService.EnrollAsOwnerAsync(userId);

        if (result.Success)
        {
            // Get the updated user and regenerate the JWT
            var user = await DbContext.Users.FirstOrDefaultAsync(u => u.strid == userId);
            if (user != null)
            {
                // Generate a fresh JWT with the newly added HotelOwner role
                var newToken = TokenProvider.GenerateToken(user);

                // Update auth state in memory for the active circuit
                if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
                {
                    await customAuth.MarkUserAsAuthenticated(newToken);
                }

                // Update browser cookie with the new token so it persists across reloads
                await JSRuntime.InvokeVoidAsync("authHelpers.setCookie", "JWToken", newToken, 3600);

                // Update session
                try
                {
                    HttpContextAccessor.HttpContext?.Session?.SetString("JWToken", newToken);
                }
                catch { }

                done = true;
                StateHasChanged();

                await Task.Delay(1500);
                Navigation.NavigateTo("/owner/dashboard", forceLoad: false);
            }
        }
        else
        {
            errorMessage = result.Message;
            isLoading = false;
            StateHasChanged();
        }
    }
}
