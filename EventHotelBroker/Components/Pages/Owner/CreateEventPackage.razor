@page "/owner/create-package"
@rendermode InteractiveServer
@using EventHotelBroker.Models
@using EventHotelBroker.Services
@using EventHotelBroker.Utils
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IEventService EventService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Environment

<PageTitle>Create Event Package - Safari Vents</PageTitle>

<link href="/css/create-package.css?v=27" rel="stylesheet" />

<div class="cp">
    <Breadcrumb Items="@breadcrumbItems" />

    <!-- Header -->
    <div class="cp-header">
        <div>
            <h1 class="cp-header-title"><i class="bi bi-gift"></i> Create Event Package</h1>
            <p class="cp-header-sub">Bundle equipment into attractive packages for customers</p>
        </div>
        <button class="cp-btn cp-btn-cancel" @onclick="Cancel">
            <i class="bi bi-arrow-left"></i> Back to Packages
        </button>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); border-radius: 8px; padding: 10px 14px; margin: 0 auto 14px auto; max-width: 1240px; display: flex; align-items: center; gap: 8px; font-size: 12px; color: #065F46;">
            <i class="bi bi-check-circle-fill" style="color: #10B981;"></i>
            <span><strong>Success!</strong> @successMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background: rgba(220,53,69,0.08); border: 1px solid rgba(220,53,69,0.25); border-radius: 8px; padding: 10px 14px; margin: 0 auto 14px auto; max-width: 1240px; display: flex; align-items: center; gap: 8px; font-size: 12px; color: #991B1B;">
            <i class="bi bi-exclamation-triangle-fill" style="color: #DC2626;"></i>
            <span><strong>Error!</strong> @errorMessage</span>
        </div>
    }

    <EditForm Model="@package" OnValidSubmit="@HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-errors" />

        <div class="cp-layout">
            <!-- Left Main Column -->
            <div class="cp-col-main">
                <!-- Card 1: Package Information & Pricing -->
                <div class="cp-card">
                    <div class="cp-card-header">
                        <h6 class="cp-card-header-title"><i class="bi bi-gift"></i> Package Information &amp; Pricing</h6>
                    </div>
                    <div class="cp-card-body">
                        <!-- Row 1: Name & Type -->
                        <div class="cp-grid-name-type">
                            <div class="cp-field">
                                <label class="cp-label">Package Name <span class="req">*</span></label>
                                <InputText @bind-Value="package.Name" class="cp-input" placeholder="e.g., Premium Wedding Package" />
                                <ValidationMessage For="@(() => package.Name)" />
                            </div>
                            <div class="cp-field">
                                <label class="cp-label">Package Type <span class="req">*</span></label>
                                <InputSelect @bind-Value="package.PackageType" class="cp-select">
                                    <option value="">Select Type</option>
                                    <option value="Wedding">Wedding</option>
                                    <option value="Corporate">Corporate Event</option>
                                    <option value="Birthday">Birthday Party</option>
                                    <option value="Conference">Conference</option>
                                    <option value="Party">Party</option>
                                    <option value="Festival">Festival</option>
                                    <option value="Exhibition">Exhibition</option>
                                    <option value="Custom">Custom Event</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => package.PackageType)" />
                            </div>
                        </div>

                        <!-- Row 2: Pricing & Capacity -->
                        <div class="cp-grid-2">
                            <div class="cp-field">
                                <label class="cp-label">Total Price (KES) <span class="req">*</span></label>
                                <div class="cp-input-group">
                                    <span class="cp-input-prefix">KES</span>
                                    <InputNumber @bind-Value="package.TotalPrice" class="cp-input" placeholder="0.00" step="0.01" />
                                </div>
                                <ValidationMessage For="@(() => package.TotalPrice)" />
                            </div>
                            <div class="cp-field">
                                <label class="cp-label">Discounted Price (Optional)</label>
                                <div class="cp-input-group">
                                    <span class="cp-input-prefix">KES</span>
                                    <InputNumber @bind-Value="package.DiscountedPrice" class="cp-input" placeholder="0.00" step="0.01" />
                                </div>
                            </div>
                        </div>

                        <div class="cp-grid-2">
                            <div class="cp-field">
                                <label class="cp-label">Minimum Guests <span class="req">*</span></label>
                                <InputNumber @bind-Value="package.MinGuests" class="cp-input" placeholder="0" min="1" />
                                <ValidationMessage For="@(() => package.MinGuests)" />
                            </div>
                            <div class="cp-field">
                                <label class="cp-label">Maximum Guests <span class="req">*</span></label>
                                <InputNumber @bind-Value="package.MaxGuests" class="cp-input" placeholder="0" min="1" />
                                <ValidationMessage For="@(() => package.MaxGuests)" />
                            </div>
                        </div>

                        <!-- Row 3: Description -->
                        <div class="cp-field">
                            <label class="cp-label">Description <span class="req">*</span></label>
                            <InputTextArea @bind-Value="package.Description" class="cp-input" rows="2"
                                placeholder="Describe what's included in this package and what makes it special..." />
                            <ValidationMessage For="@(() => package.Description)" />
                        </div>
                    </div>
                </div>

                <!-- Card 2: Features -->
                <div class="cp-card">
                    <div class="cp-card-header">
                        <h6 class="cp-card-header-title"><i class="bi bi-list-check"></i> Package Features</h6>
                    </div>
                    <div class="cp-card-body">
                        <div class="cp-field">
                            <label class="cp-label">Features (one item per line)</label>
                            <textarea @bind="featuresText" class="cp-input" rows="3"
                                placeholder="White Wedding Tent 20x30&#10;300 Chiavari Chairs&#10;Sound System&#10;LED Lighting"></textarea>
                            <span class="cp-hint">Each line is formatted as a distinct bullet item on the package card.</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(featuresText))
                        {
                            var features = featuresText.Split('\n', StringSplitOptions.RemoveEmptyEntries);
                            <div style="background: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; padding: 10px 14px; margin-top: 8px;">
                                <div style="font-size: 11px; font-weight: 700; color: #6B7280; text-transform: uppercase; margin-bottom: 6px;">Feature Preview (@features.Length items)</div>
                                <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                    @foreach (var feature in features)
                                    {
                                        <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 11.5px; background: #FFF7ED; color: #9A3412; border: 1px solid #FED7AA; padding: 2px 8px; border-radius: 6px;">
                                            <i class="bi bi-check2" style="color: #DD7A28;"></i> @feature.Trim()
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Sidebar Column (Sticky) -->
            <div class="cp-col-side">
                <!-- Actions & Settings Card -->
                <div class="cp-card">
                    <div class="cp-card-header">
                        <h6 class="cp-card-header-title"><i class="bi bi-sliders"></i> Package Settings &amp; Save</h6>
                    </div>
                    <div class="cp-card-body">
                        <!-- Toggles in compact list -->
                        <label class="cp-toggle-box">
                            <div>
                                <span class="cp-toggle-label">Active Listing</span>
                                <span class="cp-toggle-hint">Available for booking</span>
                            </div>
                            <InputCheckbox @bind-Value="package.IsActive" id="isActive" style="width: 18px; height: 18px; cursor: pointer; accent-color: #DD7A28;" />
                        </label>

                        <label class="cp-toggle-box">
                            <div>
                                <span class="cp-toggle-label">Featured Package</span>
                                <span class="cp-toggle-hint">Highlight on homepage</span>
                            </div>
                            <InputCheckbox @bind-Value="package.IsFeatured" id="isFeatured" style="width: 18px; height: 18px; cursor: pointer; accent-color: #DD7A28;" />
                        </label>

                        <label class="cp-toggle-box">
                            <div>
                                <span class="cp-toggle-label">Customizable</span>
                                <span class="cp-toggle-hint">Allow clients to customize items</span>
                            </div>
                            <InputCheckbox @bind-Value="package.IsCustomizable" id="isCustomizable" style="width: 18px; height: 18px; cursor: pointer; accent-color: #DD7A28;" />
                        </label>

                        <button type="submit" class="cp-btn cp-btn-submit-block" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="cp-spinner me-1"></span>
                                <span>Creating Package...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg"></i>
                                <span>Create Package</span>
                            }
                        </button>
                        <button type="button" class="cp-btn cp-btn-cancel-block" @onclick="Cancel">
                            <i class="bi bi-x-lg"></i> Cancel
                        </button>
                    </div>
                </div>

                <!-- Package Image Card -->
                <div class="cp-card">
                    <div class="cp-card-header">
                        <h6 class="cp-card-header-title"><i class="bi bi-image"></i> Package Cover Image</h6>
                    </div>
                    <div class="cp-card-body">
                        <div class="cp-dropzone-compact">
                            <InputFile OnChange="OnImageSelected" accept="image/*"
                                style="position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;" />
                            <i class="bi bi-cloud-arrow-up"></i>
                            <div class="cp-dropzone-text">Click or drop cover image</div>
                            <div class="cp-dropzone-sub">Max 5MB · JPG, PNG, WebP</div>
                        </div>

                        @if (!string.IsNullOrEmpty(imagePreviewUrl))
                        {
                            <div style="position: relative; margin-top: 10px; border-radius: 8px; overflow: hidden; border: 1px solid #E5E7EB; height: 120px;">
                                <img src="@imagePreviewUrl" alt="Preview" style="width: 100%; height: 100%; object-fit: cover;" />
                                <button type="button" @onclick="RemoveImage"
                                    style="position: absolute; top: 4px; right: 4px; background: rgba(0,0,0,0.65); color: white; border: none; border-radius: 50%; width: 20px; height: 20px; font-size: 11px; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Tips Card (Styled correctly with Image 3 fix) -->
                <div class="cp-card">
                    <div class="cp-card-body" style="padding: 14px 16px;">
                        <div class="cp-tips-title"><i class="bi bi-lightbulb"></i> Package Creation Tips</div>
                        <div class="cp-tip"><i class="bi bi-check-circle-fill"></i><span><strong>Bundle Wisely:</strong> Combine items customers typically need together.</span></div>
                        <div class="cp-tip"><i class="bi bi-check-circle-fill"></i><span><strong>Competitive:</strong> Offer packages at a discount compared to single items.</span></div>
                        <div class="cp-tip"><i class="bi bi-check-circle-fill"></i><span><strong>Approval:</strong> Packages are reviewed by admin before going live.</span></div>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
</div>

@code {
    private EventPackage package = new();
    private string featuresText = string.Empty;
    private bool isSubmitting = false;
    private string? currentProviderId;
    private string? errorMessage;
    private string? successMessage;

    private UploadedFileData? selectedImage;
    private string? imagePreviewUrl;
    private const long MaxFileSize = 5 * 1024 * 1024;

    private List<BreadcrumbItem> breadcrumbItems = new()
    {
        new BreadcrumbItem { Text = "Home", Url = "/" },
        new BreadcrumbItem { Text = "Event Packages", Url = "/owner/event-packages" },
        new BreadcrumbItem { Text = "Create Package", IsActive = true }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var token = await JSRuntime.InvokeAsync<string>("authHelpers.getCookie", "JWToken");
                if (!string.IsNullOrEmpty(token))
                {
                    var customAuth = (CustomAuthenticationStateProvider)AuthStateProvider;
                    await customAuth.MarkUserAsAuthenticated(token);
                    currentProviderId = await GetCurrentUserIdAsync();
                }

                if (string.IsNullOrEmpty(currentProviderId))
                {
                    errorMessage = "You must be logged in to create a package.";
                }
                else
                {
                    package.ProviderId = currentProviderId;
                    package.IsActive = false;
                    package.IsApproved = false;
                    package.IsFeatured = false;
                    package.IsCustomizable = true;
                    package.CreatedAt = DateTime.UtcNow;
                    package.UpdatedAt = DateTime.UtcNow;
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error: {ex.Message}";
            }
            StateHasChanged();
        }
    }

    private async Task<string?> GetCurrentUserIdAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState?.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                var nameClaim = user.FindFirst(ClaimTypes.Name)?.Value;
                if (!string.IsNullOrEmpty(nameClaim))
                {
                    var parts = nameClaim.Split(',');
                    if (parts.Length > 0) return parts[0];
                }
            }
        }
        catch { }
        return null;
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > MaxFileSize) { errorMessage = "File exceeds 5MB limit."; return; }
        if (!file.ContentType.StartsWith("image/")) { errorMessage = "Only image files are allowed."; return; }

        try
        {
            var uploaded = await UploadedFileData.FromBrowserFileAsync(file, MaxFileSize);
            if (uploaded != null)
            {
                selectedImage = uploaded;
                imagePreviewUrl = uploaded.PreviewUrl;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing image: {ex.Message}";
        }
        StateHasChanged();
    }

    private void RemoveImage()
    {
        selectedImage = null;
        imagePreviewUrl = null;
        StateHasChanged();
    }

    private async Task<string?> SavePackageImage(int packageId)
    {
        if (selectedImage == null) return null;

        var webRoot = Environment.WebRootPath ?? Path.Combine(Environment.ContentRootPath, "wwwroot");
        var uploadsPath = Path.Combine(webRoot, "uploads", "packages");
        Directory.CreateDirectory(uploadsPath);

        var ext = Path.GetExtension(selectedImage.Name);
        if (string.IsNullOrEmpty(ext)) ext = ".jpg";
        var fileName = $"{packageId}_{Guid.NewGuid():N}{ext}";
        var filePath = Path.Combine(uploadsPath, fileName);

        await File.WriteAllBytesAsync(filePath, selectedImage.Data);

        return $"/uploads/packages/{fileName}";
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrEmpty(currentProviderId))
        {
            errorMessage = "You must be logged in to create a package.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            package.ProviderId = currentProviderId;
            package.IsApproved = false;
            package.IsActive = false;

            // Convert features text to JSON array
            if (!string.IsNullOrWhiteSpace(featuresText))
            {
                var features = featuresText.Split('\n', StringSplitOptions.RemoveEmptyEntries)
                    .Select(f => f.Trim())
                    .Where(f => !string.IsNullOrEmpty(f))
                    .ToList();
                package.Features = System.Text.Json.JsonSerializer.Serialize(features);
            }

            await EventService.CreatePackageAsync(package);

            // Save image after we have the package ID
            if (selectedImage != null)
            {
                var imageUrl = await SavePackageImage(package.Id);
                if (imageUrl != null)
                {
                    package.ImageUrl = imageUrl;
                    await EventService.UpdatePackageAsync(package);
                }
            }

            successMessage = "Package created successfully! It will be visible after admin approval. Redirecting...";
            StateHasChanged();
            await Task.Delay(2000);
            Navigation.NavigateTo("/owner/event-packages");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating package: {ex.Message}";
            if (ex.InnerException != null) errorMessage += $" | {ex.InnerException.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/owner/event-packages");
    }
}
