@page "/owner/edit-package/{PackageId:int}"
@rendermode InteractiveServer
@using EventHotelBroker.Models
@using EventHotelBroker.Services
@using EventHotelBroker.Utils
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IEventService EventService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Environment

<PageTitle>Edit Package - Safari Vents</PageTitle>

<link href="/css/create-package.css?v=27" rel="stylesheet" />

<div class="cp">
    <Breadcrumb Items="@breadcrumbItems" />

    <!-- Header -->
    <div class="cp-header">
        <div>
            <h1 class="cp-header-title"><i class="bi bi-pencil-square"></i> Edit Package</h1>
            <p class="cp-header-sub">Update event package details, pricing, and features</p>
        </div>
        <button class="cp-btn cp-btn-cancel" @onclick="Cancel">
            <i class="bi bi-arrow-left"></i> Back to Packages
        </button>
    </div>

    @if (isLoading)
    {
        <div style="text-align: center; padding: 3rem;">
            <div class="cp-spinner" style="width: 32px; height: 32px; border-width: 3px; margin: 0 auto 1rem;"></div>
            <p style="color: #8a8177; font-size: 0.8rem;">Loading package...</p>
        </div>
    }
    else if (package == null)
    {
        <div style="text-align: center; padding: 3rem;">
            <i class="bi bi-exclamation-triangle" style="font-size: 2.5rem; color: #C87941;"></i>
            <h5 style="margin-top: 1rem; color: #2A2A2A;">Package Not Found</h5>
            <p style="color: #8a8177; font-size: 0.8rem;">The package you're looking for doesn't exist or you don't have permission to edit it.</p>
            <a href="/owner/event-packages" class="cp-btn cp-btn-submit" style="display: inline-flex;">
                <i class="bi bi-arrow-left"></i> Back to My Packages
            </a>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); border-radius: 8px; padding: 10px 14px; margin: 0 auto 14px auto; max-width: 1240px; display: flex; align-items: center; gap: 8px; font-size: 12px; color: #065F46;">
                <i class="bi bi-check-circle-fill" style="color: #10B981;"></i>
                <span><strong>Success!</strong> @successMessage</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="background: rgba(220,53,69,0.08); border: 1px solid rgba(220,53,69,0.25); border-radius: 8px; padding: 10px 14px; margin: 0 auto 14px auto; max-width: 1240px; display: flex; align-items: center; gap: 8px; font-size: 12px; color: #991B1B;">
                <i class="bi bi-exclamation-triangle-fill" style="color: #DC2626;"></i>
                <span><strong>Error!</strong> @errorMessage</span>
            </div>
        }

        <EditForm Model="@package" OnValidSubmit="@HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-errors" />

            <div class="cp-layout">
                <!-- Left Main Column -->
                <div class="cp-col-main">
                    <!-- Status Banner -->
                    <div style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 12px; padding: 12px 16px; margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 11px; font-weight: 700; color: #6B7280; text-transform: uppercase;">Listing Status:</span>
                            @if (package.IsApproved && package.IsActive)
                            {
                                <span style="font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px; background: rgba(16,185,129,0.12); color: #065F46;">
                                    <i class="bi bi-check-circle-fill" style="color: #10B981;"></i> Approved &amp; Active
                                </span>
                            }
                            else if (package.IsApproved)
                            {
                                <span style="font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px; background: rgba(16,185,129,0.12); color: #065F46;">
                                    <i class="bi bi-check-circle-fill" style="color: #10B981;"></i> Approved
                                </span>
                            }
                            else
                            {
                                <span style="font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px; background: rgba(221,122,40,0.12); color: #9A3412;">
                                    <i class="bi bi-clock-history" style="color: #DD7A28;"></i> Pending Review
                                </span>
                            }
                        </div>
                        <span style="font-size: 11px; color: #9CA3AF;">Package ID: #@package.Id</span>
                    </div>

                    <!-- Card 1: Package Information & Pricing -->
                    <div class="cp-card">
                        <div class="cp-card-header">
                            <h6 class="cp-card-header-title"><i class="bi bi-gift"></i> Package Information &amp; Pricing</h6>
                        </div>
                        <div class="cp-card-body">
                            <!-- Row 1: Name & Type -->
                            <div class="cp-grid-name-type">
                                <div class="cp-field">
                                    <label class="cp-label">Package Name <span class="req">*</span></label>
                                    <InputText @bind-Value="package.Name" class="cp-input" placeholder="e.g., Premium Wedding Package" />
                                    <ValidationMessage For="@(() => package.Name)" />
                                </div>
                                <div class="cp-field">
                                    <label class="cp-label">Package Type <span class="req">*</span></label>
                                    <InputSelect @bind-Value="package.PackageType" class="cp-select">
                                        <option value="">Select Type</option>
                                        <option value="Wedding">Wedding</option>
                                        <option value="Corporate">Corporate Event</option>
                                        <option value="Birthday">Birthday Party</option>
                                        <option value="Conference">Conference</option>
                                        <option value="Party">Party</option>
                                        <option value="Festival">Festival</option>
                                        <option value="Exhibition">Exhibition</option>
                                        <option value="Custom">Custom Event</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => package.PackageType)" />
                                </div>
                            </div>

                            <!-- Row 2: Pricing & Capacity -->
                            <div class="cp-grid-2">
                                <div class="cp-field">
                                    <label class="cp-label">Total Price (KES) <span class="req">*</span></label>
                                    <div class="cp-input-group">
                                        <span class="cp-input-prefix">KES</span>
                                        <InputNumber @bind-Value="package.TotalPrice" class="cp-input" placeholder="0.00" step="0.01" />
                                    </div>
                                    <ValidationMessage For="@(() => package.TotalPrice)" />
                                </div>
                                <div class="cp-field">
                                    <label class="cp-label">Discounted Price (Optional)</label>
                                    <div class="cp-input-group">
                                        <span class="cp-input-prefix">KES</span>
                                        <InputNumber @bind-Value="package.DiscountedPrice" class="cp-input" placeholder="0.00" step="0.01" />
                                    </div>
                                </div>
                            </div>

                            @if (package.DiscountedPrice.HasValue && package.TotalPrice > 0 && package.TotalPrice > package.DiscountedPrice.Value)
                            {
                                var savings = package.TotalPrice - package.DiscountedPrice.Value;
                                var percentage = (savings / package.TotalPrice) * 100;
                                <div class="cp-savings">
                                    <i class="bi bi-tag-fill"></i>
                                    Customers save <strong>KES @savings.ToString("N0")</strong> (@percentage.ToString("N0")% off)
                                </div>
                            }

                            <div class="cp-grid-2">
                                <div class="cp-field">
                                    <label class="cp-label">Minimum Guests <span class="req">*</span></label>
                                    <InputNumber @bind-Value="package.MinGuests" class="cp-input" placeholder="0" min="1" />
                                    <ValidationMessage For="@(() => package.MinGuests)" />
                                </div>
                                <div class="cp-field">
                                    <label class="cp-label">Maximum Guests <span class="req">*</span></label>
                                    <InputNumber @bind-Value="package.MaxGuests" class="cp-input" placeholder="0" min="1" />
                                    <ValidationMessage For="@(() => package.MaxGuests)" />
                                </div>
                            </div>

                            <!-- Row 3: Description -->
                            <div class="cp-field">
                                <label class="cp-label">Description <span class="req">*</span></label>
                                <InputTextArea @bind-Value="package.Description" class="cp-input" rows="2"
                                    placeholder="Describe what's included in this package and what makes it special..." />
                                <ValidationMessage For="@(() => package.Description)" />
                            </div>
                        </div>
                    </div>

                    <!-- Card 2: Features -->
                    <div class="cp-card">
                        <div class="cp-card-header">
                            <h6 class="cp-card-header-title"><i class="bi bi-list-check"></i> Package Features</h6>
                        </div>
                        <div class="cp-card-body">
                            <div class="cp-field">
                                <label class="cp-label">Features (one item per line)</label>
                                <textarea @bind="featuresText" class="cp-input" rows="3"
                                    placeholder="White Wedding Tent 20x30&#10;300 Chiavari Chairs&#10;Sound System&#10;LED Lighting"></textarea>
                                <span class="cp-hint">Each line is formatted as a distinct bullet item on the package card.</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(featuresText))
                            {
                                var features = featuresText.Split('\n', StringSplitOptions.RemoveEmptyEntries);
                                <div style="background: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; padding: 10px 14px; margin-top: 8px;">
                                    <div style="font-size: 11px; font-weight: 700; color: #6B7280; text-transform: uppercase; margin-bottom: 6px;">Feature Preview (@features.Length items)</div>
                                    <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                        @foreach (var feature in features)
                                        {
                                            <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 11.5px; background: #FFF7ED; color: #9A3412; border: 1px solid #FED7AA; padding: 2px 8px; border-radius: 6px;">
                                                <i class="bi bi-check2" style="color: #DD7A28;"></i> @feature.Trim()
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Right Sidebar Column (Sticky) -->
                <div class="cp-col-side">
                    <!-- Actions & Settings Card -->
                    <div class="cp-card">
                        <div class="cp-card-header">
                            <h6 class="cp-card-header-title"><i class="bi bi-sliders"></i> Package Settings &amp; Save</h6>
                        </div>
                        <div class="cp-card-body">
                            <!-- Toggles in compact list -->
                            <label class="cp-toggle-box">
                                <div>
                                    <span class="cp-toggle-label">Active Listing</span>
                                    <span class="cp-toggle-hint">Available for booking</span>
                                </div>
                                <InputCheckbox @bind-Value="package.IsActive" id="isActive" style="width: 18px; height: 18px; cursor: pointer; accent-color: #DD7A28;" />
                            </label>

                            <label class="cp-toggle-box">
                                <div>
                                    <span class="cp-toggle-label">Featured Package</span>
                                    <span class="cp-toggle-hint">Highlight on homepage</span>
                                </div>
                                <InputCheckbox @bind-Value="package.IsFeatured" id="isFeatured" style="width: 18px; height: 18px; cursor: pointer; accent-color: #DD7A28;" />
                            </label>

                            <label class="cp-toggle-box">
                                <div>
                                    <span class="cp-toggle-label">Customizable</span>
                                    <span class="cp-toggle-hint">Allow clients to customize items</span>
                                </div>
                                <InputCheckbox @bind-Value="package.IsCustomizable" id="isCustomizable" style="width: 18px; height: 18px; cursor: pointer; accent-color: #DD7A28;" />
                            </label>

                            <button type="submit" class="cp-btn cp-btn-submit-block" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="cp-spinner me-1"></span>
                                    <span>Saving Changes...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-lg"></i>
                                    <span>Save Changes</span>
                                }
                            </button>
                            <button type="button" class="cp-btn cp-btn-cancel-block" @onclick="Cancel">
                                <i class="bi bi-x-lg"></i> Cancel
                            </button>
                            <button type="button" class="cp-btn cp-btn-cancel-block" style="color: #DC2626; border-color: rgba(220,53,69,0.25); background: #FEF2F2;" @onclick="() => showDeleteConfirm = true">
                                <i class="bi bi-trash"></i> Delete Package
                            </button>
                        </div>
                    </div>

                    <!-- Package Image Card -->
                    <div class="cp-card">
                        <div class="cp-card-header">
                            <h6 class="cp-card-header-title"><i class="bi bi-image"></i> Package Cover Image</h6>
                        </div>
                        <div class="cp-card-body">
                            @if (!string.IsNullOrEmpty(package.ImageUrl) && !removeExistingImage)
                            {
                                <div style="position: relative; margin-bottom: 12px; border-radius: 8px; overflow: hidden; border: 1px solid #E5E7EB; height: 130px;">
                                    <img src="@package.ImageUrl" alt="Current package image" style="width: 100%; height: 100%; object-fit: cover;" />
                                    <span style="position: absolute; bottom: 6px; left: 6px; background: rgba(0,0,0,0.7); color: #fff; font-size: 10px; font-weight: 600; padding: 2px 6px; border-radius: 4px;">CURRENT</span>
                                    <button type="button" @onclick="() => removeExistingImage = true"
                                        style="position: absolute; top: 6px; right: 6px; background: rgba(0,0,0,0.65); color: white; border: none; border-radius: 50%; width: 22px; height: 22px; font-size: 11px; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }

                            <div class="cp-dropzone-compact">
                                <InputFile OnChange="OnImageSelected" accept="image/*"
                                    style="position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;" />
                                <i class="bi bi-cloud-arrow-up"></i>
                                <div class="cp-dropzone-text">@(string.IsNullOrEmpty(package.ImageUrl) || removeExistingImage ? "Click or drop cover image" : "Upload new image to replace")</div>
                                <div class="cp-dropzone-sub">Max 5MB · JPG, PNG, WebP</div>
                            </div>

                            @if (!string.IsNullOrEmpty(newImagePreviewUrl))
                            {
                                <div style="position: relative; margin-top: 10px; border-radius: 8px; overflow: hidden; border: 1px solid #10B981; height: 120px;">
                                    <img src="@newImagePreviewUrl" alt="New preview" style="width: 100%; height: 100%; object-fit: cover;" />
                                    <span style="position: absolute; bottom: 6px; left: 6px; background: #10B981; color: white; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px;">NEW IMAGE</span>
                                    <button type="button" @onclick="RemoveNewImage"
                                        style="position: absolute; top: 6px; right: 6px; background: rgba(0,0,0,0.65); color: white; border: none; border-radius: 50%; width: 22px; height: 22px; font-size: 11px; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Info Note Card -->
                    <div class="cp-card">
                        <div class="cp-card-body" style="padding: 12px 14px;">
                            <div style="display: flex; gap: 8px; align-items: flex-start;">
                                <i class="bi bi-info-circle-fill" style="color: #DD7A28; font-size: 14px; margin-top: 1px;"></i>
                                <div style="font-size: 11.5px; color: #4B5563; line-height: 1.45;">
                                    <strong>Listing Note:</strong> Approved packages remain live while minor updates are saved. Significant changes may require administrative re-review.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    }
</div>

@if (showDeleteConfirm)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 1050; display: flex; align-items: center; justify-content: center;"
         @onclick="() => showDeleteConfirm = false">
        <div style="background: #fff; border-radius: 14px; padding: 1.75rem; max-width: 400px; width: 92%; box-shadow: 0 12px 40px rgba(0,0,0,0.18);"
             @onclick:stopPropagation="true">
            <div style="text-align: center;">
                <div style="width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 1.5rem; background: rgba(220,53,69,0.1); color: #dc3545;">
                    <i class="bi bi-trash"></i>
                </div>
                <h5 style="margin: 0 0 0.4rem; font-size: 1rem; color: #2A2A2A; font-weight: 700;">Delete Package?</h5>
                <p style="font-size: 0.8rem; color: #8a8177; margin: 0 0 0.25rem;">
                    Are you sure you want to delete <strong>@package?.Name</strong>? This action cannot be undone.
                </p>
            </div>
            <div style="display: flex; gap: 0.5rem; justify-content: center; margin-top: 1.25rem;">
                <button style="padding: 0.45rem 1.1rem; border-radius: 8px; border: 1px solid #dee2e6; background: #fff; color: #5c5550; font-size: 0.78rem; font-weight: 600; cursor: pointer;"
                        @onclick="() => showDeleteConfirm = false">
                    Cancel
                </button>
                <button style="padding: 0.45rem 1.1rem; border-radius: 8px; border: none; background: #dc3545; color: #fff; font-size: 0.78rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;"
                        @onclick="DeletePackage">
                    <i class="bi bi-trash"></i> Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int PackageId { get; set; }

    private EventPackage? package;
    private string featuresText = string.Empty;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showDeleteConfirm = false;
    private string? currentProviderId;
    private string? errorMessage;
    private string? successMessage;

    private bool removeExistingImage = false;
    private UploadedFileData? selectedNewImage;
    private string? newImagePreviewUrl;
    private string? originalImageUrl;
    private const long MaxFileSize = 5 * 1024 * 1024;

    private List<BreadcrumbItem> breadcrumbItems = new()
    {
        new BreadcrumbItem { Text = "Home", Url = "/" },
        new BreadcrumbItem { Text = "Event Packages", Url = "/owner/event-packages" },
        new BreadcrumbItem { Text = "Edit Package", IsActive = true }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var token = await JSRuntime.InvokeAsync<string>("authHelpers.getCookie", "JWToken");
                if (!string.IsNullOrEmpty(token))
                {
                    var customAuth = (CustomAuthenticationStateProvider)AuthStateProvider;
                    await customAuth.MarkUserAsAuthenticated(token);
                    currentProviderId = await GetCurrentUserIdAsync();
                }

                if (string.IsNullOrEmpty(currentProviderId))
                {
                    errorMessage = "You must be logged in to edit a package.";
                    isLoading = false;
                    StateHasChanged();
                    return;
                }

                package = await EventService.GetPackageByIdAsync(PackageId);

                if (package == null || package.ProviderId != currentProviderId)
                {
                    package = null;
                    isLoading = false;
                    StateHasChanged();
                    return;
                }

                originalImageUrl = package.ImageUrl;

                // Parse features JSON to text
                if (!string.IsNullOrEmpty(package.Features))
                {
                    try
                    {
                        var features = System.Text.Json.JsonSerializer.Deserialize<List<string>>(package.Features);
                        if (features != null)
                            featuresText = string.Join("\n", features);
                    }
                    catch { featuresText = package.Features; }
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error loading package: {ex.Message}";
            }
            finally
            {
                isLoading = false;
            }
            StateHasChanged();
        }
    }

    private async Task<string?> GetCurrentUserIdAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState?.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                var nameClaim = user.FindFirst(ClaimTypes.Name)?.Value;
                if (!string.IsNullOrEmpty(nameClaim))
                {
                    var parts = nameClaim.Split(',');
                    if (parts.Length > 0) return parts[0];
                }
            }
        }
        catch { }
        return null;
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > MaxFileSize) { errorMessage = "File exceeds 5MB limit."; return; }
        if (!file.ContentType.StartsWith("image/")) { errorMessage = "Only image files are allowed."; return; }

        try
        {
            var uploaded = await UploadedFileData.FromBrowserFileAsync(file, MaxFileSize);
            if (uploaded != null)
            {
                selectedNewImage = uploaded;
                newImagePreviewUrl = uploaded.PreviewUrl;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing image: {ex.Message}";
        }
        StateHasChanged();
    }

    private void RemoveNewImage()
    {
        selectedNewImage = null;
        newImagePreviewUrl = null;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (package == null || string.IsNullOrEmpty(currentProviderId)) return;

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            // Convert features text to JSON
            if (!string.IsNullOrWhiteSpace(featuresText))
            {
                var features = featuresText.Split('\n', StringSplitOptions.RemoveEmptyEntries)
                    .Select(f => f.Trim())
                    .Where(f => !string.IsNullOrEmpty(f))
                    .ToList();
                package.Features = System.Text.Json.JsonSerializer.Serialize(features);
            }
            else
            {
                package.Features = null;
            }

            // Handle image changes
            if (selectedNewImage != null)
            {
                // Delete old image file if exists
                if (!string.IsNullOrEmpty(originalImageUrl))
                {
                    var oldPath = Path.Combine(Environment.WebRootPath, originalImageUrl.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                    if (File.Exists(oldPath)) File.Delete(oldPath);
                }

                // Save new image
                var webRoot = Environment.WebRootPath ?? Path.Combine(Environment.ContentRootPath, "wwwroot");
                var uploadsPath = Path.Combine(webRoot, "uploads", "packages");
                Directory.CreateDirectory(uploadsPath);
                var ext = Path.GetExtension(selectedNewImage.Name);
                if (string.IsNullOrEmpty(ext)) ext = ".jpg";
                var fileName = $"{package.Id}_{Guid.NewGuid():N}{ext}";
                var filePath = Path.Combine(uploadsPath, fileName);

                await File.WriteAllBytesAsync(filePath, selectedNewImage.Data);

                package.ImageUrl = $"/uploads/packages/{fileName}";
            }
            else if (removeExistingImage)
            {
                // Remove existing image
                if (!string.IsNullOrEmpty(originalImageUrl))
                {
                    var oldPath = Path.Combine(Environment.WebRootPath, originalImageUrl.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                    if (File.Exists(oldPath)) File.Delete(oldPath);
                }
                package.ImageUrl = null;
            }

            await EventService.UpdatePackageAsync(package);

            successMessage = "Package updated successfully! Redirecting...";
            StateHasChanged();
            await Task.Delay(1500);
            Navigation.NavigateTo("/owner/event-packages");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating package: {ex.Message}";
            if (ex.InnerException != null) errorMessage += $" | {ex.InnerException.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeletePackage()
    {
        if (package == null) return;
        try
        {
            // Delete image file
            if (!string.IsNullOrEmpty(package.ImageUrl))
            {
                var imgPath = Path.Combine(Environment.WebRootPath, package.ImageUrl.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                if (File.Exists(imgPath)) File.Delete(imgPath);
            }
            await EventService.DeletePackageAsync(package.Id);
            Navigation.NavigateTo("/owner/event-packages");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting package: {ex.Message}";
            showDeleteConfirm = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/owner/event-packages");
    }
}
