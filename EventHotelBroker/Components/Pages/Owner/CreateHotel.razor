@page "/owner/hotels/create"
@page "/owner/create-hotel"
@rendermode InteractiveServer
@using EventHotelBroker.Models
@using EventHotelBroker.Services
@using EventHotelBroker.Repositories
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IHotelService HotelService
@inject IUnitOfWork UnitOfWork
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Environment
@implements IDisposable
@using EventHotelBroker.Utils

<PageTitle>Add New Hotel - Safari Vents</PageTitle>

<link href="/css/create-hotel.css?v=27" rel="stylesheet" />
<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyA7eRAscqIJa-F2uUfvyS-rg7dAg02sXCk&libraries=places,geometry"></script>

<div class="ch">
    <Breadcrumb Items="@breadcrumbItems" />

    <!-- Header -->
    <div class="ch-header">
        <div>
            <h1 class="ch-header-title"><i class="bi bi-plus-circle"></i> Add New Hotel</h1>
            <p class="ch-header-sub">Create a new hotel listing for your property</p>
        </div>
        <button class="ch-btn ch-btn-cancel" @onclick="Cancel">
            <i class="bi bi-arrow-left"></i> Back to Hotels
        </button>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="ch-alert ch-alert-success" style="max-width: 1240px; margin: 0 auto 14px auto;">
            <i class="bi bi-check-circle-fill"></i>
            <span><strong>Success!</strong> @successMessage</span>
            <button class="ch-alert-close" @onclick="() => successMessage = null"><i class="bi bi-x"></i></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="ch-alert ch-alert-error" style="max-width: 1240px; margin: 0 auto 14px auto;">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span><strong>Error!</strong> @errorMessage</span>
            <button class="ch-alert-close" @onclick="() => errorMessage = null"><i class="bi bi-x"></i></button>
        </div>
    }

    <EditForm Model="hotel" OnValidSubmit="HandleSubmit" FormName="createHotelForm">
        <DataAnnotationsValidator />

        <div class="ch-layout">
            <!-- Left Main Column -->
            <div class="ch-col-main">
                <!-- Card 1: Basic Information -->
                <div class="ch-card">
                    <div class="ch-card-header">
                        <h6 class="ch-card-header-title"><i class="bi bi-info-circle"></i> Basic Information</h6>
                    </div>
                    <div class="ch-card-body">
                        <!-- Row 1: Name & Category -->
                        <div class="ch-grid-name-cat">
                            <div class="ch-field">
                                <label class="ch-label" for="name">Hotel Name <span class="req">*</span></label>
                                <InputText @bind-Value="hotel.Name" class="ch-input" id="name" placeholder="e.g., Grand Plaza Hotel" />
                                <ValidationMessage For="@(() => hotel.Name)" />
                            </div>
                            <div class="ch-field">
                                <label class="ch-label" for="category">Category <span class="req">*</span></label>
                                <InputSelect @bind-Value="hotel.Category" class="ch-select" id="category">
                                    <option value="">Select category</option>
                                    @foreach (var category in availableCategories)
                                    {
                                        <option value="@category">@category</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => hotel.Category)" />
                            </div>
                        </div>

                        <!-- Row 2: Hotel Tier, Capacity, Price -->
                        <div class="ch-grid-3">
                            <div class="ch-field">
                                <label class="ch-label" for="hotelCategory">Star Tier <span class="req">*</span></label>
                                <InputSelect @bind-Value="hotel.HotelCategoryId" class="ch-select" id="hotelCategory">
                                    <option value="0">Select tier</option>
                                    @if (availableHotelCategories != null)
                                    {
                                        @foreach (var cat in availableHotelCategories)
                                        {
                                            <option value="@cat.Id">@cat.Name (@cat.Rating)</option>
                                        }
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => hotel.HotelCategoryId)" />
                            </div>
                            <div class="ch-field">
                                <label class="ch-label" for="capacity">Capacity (Guests) <span class="req">*</span></label>
                                <InputNumber @bind-Value="hotel.Capacity" class="ch-input" id="capacity" />
                                <ValidationMessage For="@(() => hotel.Capacity)" />
                            </div>
                            <div class="ch-field">
                                <label class="ch-label" for="price">Price / Night (KES) <span class="req">*</span></label>
                                <InputNumber @bind-Value="hotel.PricePerNight" class="ch-input" id="price" />
                                <ValidationMessage For="@(() => hotel.PricePerNight)" />
                            </div>
                        </div>

                        <!-- Row 3: Phone & Email -->
                        <div class="ch-grid-2">
                            <div class="ch-field">
                                <label class="ch-label" for="phone">Phone Number <span class="req">*</span></label>
                                <InputText @bind-Value="hotel.Phone" class="ch-input" id="phone" placeholder="+254 7XX XXX XXX" />
                                <ValidationMessage For="@(() => hotel.Phone)" />
                            </div>
                            <div class="ch-field">
                                <label class="ch-label" for="email">Contact Email <span class="req">*</span></label>
                                <InputText @bind-Value="hotel.Email" class="ch-input" id="email" placeholder="hotel@example.com" />
                                <ValidationMessage For="@(() => hotel.Email)" />
                            </div>
                        </div>

                        <!-- Row 4: Description -->
                        <div class="ch-field">
                            <label class="ch-label" for="description">Description <span class="req">*</span></label>
                            <InputTextArea @bind-Value="hotel.Description" class="ch-input" id="description" rows="2"
                                placeholder="Describe the hotel, key features, and highlights..." />
                            <ValidationMessage For="@(() => hotel.Description)" />
                        </div>
                    </div>
                </div>

                <!-- Card 2: Location Details -->
                <div class="ch-card">
                    <div class="ch-card-header">
                        <h6 class="ch-card-header-title"><i class="bi bi-geo-alt"></i> Location Details</h6>
                    </div>
                    <div class="ch-card-body">
                        <div class="ch-grid-loc-addr">
                            <div class="ch-field">
                                <label class="ch-label" for="address">Street Address <span class="req">*</span></label>
                                <InputText @bind-Value="hotel.Address" class="ch-input" id="address" placeholder="e.g., Kenyatta Avenue" />
                                <ValidationMessage For="@(() => hotel.Address)" />
                            </div>
                            <div class="ch-field">
                                <label class="ch-label" for="city">City <span class="req">*</span></label>
                                <InputText @bind-Value="hotel.City" class="ch-input" id="city" placeholder="e.g., Nairobi" />
                                <ValidationMessage For="@(() => hotel.City)" />
                            </div>
                            <div class="ch-field">
                                <label class="ch-label" for="country">Country <span class="req">*</span></label>
                                <InputText @bind-Value="hotel.Country" class="ch-input" id="country" placeholder="Kenya" />
                                <ValidationMessage For="@(() => hotel.Country)" />
                            </div>
                        </div>

                        <!-- Search Location & Map Toggle -->
                        <div class="ch-field">
                            <label class="ch-label">Search Location &amp; Pin Coordinates</label>
                            <div class="map-search-container">
                                <input id="mapSearchInput" type="text" class="ch-input" placeholder="Type to search on Google Maps (e.g. Westlands, Nairobi)..." autocomplete="off" />
                                <div id="hotelMap" style="height: 220px; width: 100%; border-radius: 8px; border: 1px solid #E5E7EB; display: none; margin-top: 8px;"></div>
                            </div>
                        </div>

                        <!-- Auto-filled Coordinates in compact row -->
                        <div class="ch-grid-2">
                            <div class="ch-field">
                                <label class="ch-label" for="latitude">Latitude (Auto-filled)</label>
                                <InputNumber @bind-Value="hotel.Latitude" class="ch-input" id="latitude" placeholder="-1.286389" readonly />
                            </div>
                            <div class="ch-field">
                                <label class="ch-label" for="longitude">Longitude (Auto-filled)</label>
                                <InputNumber @bind-Value="hotel.Longitude" class="ch-input" id="longitude" placeholder="36.817223" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Amenities & Features -->
                <div class="ch-card">
                    <div class="ch-card-header">
                        <h6 class="ch-card-header-title"><i class="bi bi-star"></i> Amenities &amp; Features (@selectedAmenityIds.Count selected)</h6>
                    </div>
                    <div class="ch-card-body">
                        @if (availableAmenities.Any())
                        {
                            <div class="ch-chips">
                                @foreach (var amenity in availableAmenities)
                                {
                                    <label class="ch-chip @(selectedAmenityIds.Contains(amenity.Id) ? "selected" : "")">
                                        <input type="checkbox"
                                            @onchange="@((e) => ToggleAmenity(amenity.Id, (bool)e.Value!))" />
                                        @if (selectedAmenityIds.Contains(amenity.Id))
                                        {
                                            <i class="bi bi-check-lg"></i>
                                        }
                                        @amenity.Name
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <p style="font-size: 0.75rem; color: #8a8177; margin: 0;">Loading amenities...</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Sidebar Column (Sticky) -->
            <div class="ch-col-side">
                <!-- Actions & Status Card -->
                <div class="ch-card">
                    <div class="ch-card-header">
                        <h6 class="ch-card-header-title"><i class="bi bi-send"></i> Publish &amp; Save</h6>
                    </div>
                    <div class="ch-card-body">
                        <!-- Publish Toggle -->
                        <label class="ch-toggle-box">
                            <div>
                                <span class="ch-toggle-label">Publish Listing</span>
                                <span class="ch-toggle-hint">Submit for admin approval</span>
                            </div>
                            <InputCheckbox @bind-Value="hotel.IsPublished" id="isPublished" style="width: 18px; height: 18px; cursor: pointer; accent-color: #DD7A28;" />
                        </label>

                        <!-- Review Process Info -->
                        <div class="ch-review-note">
                            <i class="bi bi-info-circle"></i>
                            <div>New listings are reviewed by admin within 24-48 hours before public visibility.</div>
                        </div>

                        <!-- Buttons -->
                        <button type="submit" class="ch-btn ch-btn-submit-block" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="ch-spinner me-1"></span>
                                <span>Creating Hotel...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg"></i>
                                <span>Create Hotel</span>
                            }
                        </button>
                        <button type="button" class="ch-btn ch-btn-cancel-block" @onclick="Cancel">
                            <i class="bi bi-x-lg"></i> Cancel
                        </button>
                    </div>
                </div>

                <!-- Photos Card -->
                <div class="ch-card">
                    <div class="ch-card-header">
                        <h6 class="ch-card-header-title"><i class="bi bi-images"></i> Photos (@selectedImages.Count/5)</h6>
                    </div>
                    <div class="ch-card-body">
                        <div class="ch-dropzone-compact">
                            <InputFile OnChange="OnImagesSelected" multiple accept="image/*"
                                style="position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;" />
                            <i class="bi bi-cloud-arrow-up"></i>
                            <div class="ch-dropzone-text">Click or drop images here</div>
                            <div class="ch-dropzone-sub">Max 5 photos · Up to 5MB each</div>
                        </div>

                        @if (selectedImages.Any())
                        {
                            <div class="ch-thumb-grid">
                                @foreach (var img in selectedImages)
                                {
                                    <div class="ch-thumb-item">
                                        @if (imagePreviewUrls.ContainsKey(img.Name))
                                        {
                                            <img src="@imagePreviewUrls[img.Name]" alt="@img.Name" />
                                        }
                                        else
                                        {
                                            <div style="display:flex;align-items:center;justify-content:center;height:100%;background:#eee;">
                                                <i class="bi bi-image" style="color:#999;"></i>
                                            </div>
                                        }
                                        <button type="button" class="ch-thumb-del" @onclick="() => RemoveImage(img.Name)">
                                            <i class="bi bi-x"></i>
                                        </button>
                                        @if (primaryImageName == img.Name)
                                        {
                                            <span class="ch-thumb-primary"><i class="bi bi-star-fill"></i> Main</span>
                                        }
                                        else
                                        {
                                            <button type="button" @onclick="() => primaryImageName = img.Name"
                                                style="position: absolute; bottom: 2px; left: 2px; background: rgba(0,0,0,0.5); color: #fff; border: none; font-size: 8px; border-radius: 3px; padding: 1px 3px; cursor: pointer;">
                                                Set Main
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private Hotel hotel { get; set; } = new() { Currency = "KES", Country = "Kenya" };

    private List<Amenity> availableAmenities = new();
    private List<int> selectedAmenityIds = new();
    private List<HotelCategory>? availableHotelCategories;
    private string? errorMessage;
    private string? successMessage;
    private bool isSubmitting = false;
    private string? currentUserId;
    private List<UploadedFileData> selectedImages = new();
    private Dictionary<string, string> imagePreviewUrls = new();
    private string? primaryImageName;
    private const long MaxFileSize = 5 * 1024 * 1024; // 5MB

    private List<string> availableCategories = new()
    {
        "Hotel",
        "Airbnb",
        "Restaurant",
        "Venue",
        "Resort",
        "Lodge",
        "Guest House",
        "Apartment"
    };

    private List<BreadcrumbItem> breadcrumbItems = new()
    {
        new BreadcrumbItem { Text = "Home", Url = "/" },
        new BreadcrumbItem { Text = "Owner Dashboard", Url = "/owner/dashboard" },
        new BreadcrumbItem { Text = "Create Hotel", IsActive = true }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            availableAmenities = (await UnitOfWork.Amenities.GetAllAsync()).ToList();
            availableHotelCategories = (await UnitOfWork.HotelCategories.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load amenities or categories.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var token = await JSRuntime.InvokeAsync<string>("authHelpers.getCookie", "JWToken");
                
                if (!string.IsNullOrEmpty(token))
                {
                    var customAuth = (CustomAuthenticationStateProvider)AuthStateProvider;
                    await customAuth.MarkUserAsAuthenticated(token);
                    currentUserId = await GetCurrentUserIdAsync();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Authentication error: {ex.Message}";
            }

            if (string.IsNullOrEmpty(currentUserId))
            {
                errorMessage = "User not authenticated. Please log in again.";
            }
            else
            {
                errorMessage = null;
            }
            
            StateHasChanged();

            // Initialize Map Autocomplete
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("mapHelper.initAutocomplete", objRef, "mapSearchInput", "hotelMap");
        }
    }

    private DotNetObjectReference<CreateHotel>? objRef;

    public void Dispose()
    {
        objRef?.Dispose();
    }

    [JSInvokable]
    public async Task UpdateLocationFromJS(string address, string city, string country, double lat, double lng)
    {
        hotel.Address = address;
        hotel.City = city;
        hotel.Country = country;
        hotel.Latitude = (decimal?)lat;
        hotel.Longitude = (decimal?)lng;
        StateHasChanged();
    }

    private async Task<string?> GetCurrentUserIdAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState?.User;
            
            if (user?.Identity?.IsAuthenticated == true)
            {
                // Name claim format: "strid,AccountType,IsTwoFAEnabled"
                var nameClaim = user.FindFirst(ClaimTypes.Name)?.Value;
                if (!string.IsNullOrEmpty(nameClaim))
                {
                    var parts = nameClaim.Split(',');
                    if (parts.Length > 0)
                    {
                        System.Diagnostics.Debug.WriteLine($"[CreateHotel] Extracted userId (strid): '{parts[0]}'");
                        return parts[0];
                    }
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[CreateHotel] Error getting user ID: {ex.Message}");
        }
        
        return null;
    }


    private async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var files = e.GetMultipleFiles(5);
            foreach (var file in files)
            {
                if (selectedImages.Count >= 5) break;
                if (file.Size > MaxFileSize)
                {
                    errorMessage = $"File '{file.Name}' exceeds 5MB limit.";
                    continue;
                }
                if (!file.ContentType.StartsWith("image/"))
                {
                    continue;
                }

                var uploaded = await UploadedFileData.FromBrowserFileAsync(file, MaxFileSize);
                if (uploaded != null)
                {
                    selectedImages.Add(uploaded);
                    imagePreviewUrls[uploaded.Name] = uploaded.PreviewUrl;

                    if (primaryImageName == null)
                        primaryImageName = uploaded.Name;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing image: {ex.Message}";
        }
        StateHasChanged();
    }

    private void RemoveImage(string name)
    {
        selectedImages.RemoveAll(f => f.Name == name);
        imagePreviewUrls.Remove(name);
        if (primaryImageName == name)
            primaryImageName = selectedImages.FirstOrDefault()?.Name;
        StateHasChanged();
    }

    private async Task SaveHotelImages(int hotelId)
    {
        var webRoot = Environment.WebRootPath ?? Path.Combine(Environment.ContentRootPath, "wwwroot");
        var uploadsPath = Path.Combine(webRoot, "uploads", "hotels");
        Directory.CreateDirectory(uploadsPath);

        foreach (var file in selectedImages)
        {
            var ext = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(ext)) ext = ".jpg";
            var fileName = $"{hotelId}_{Guid.NewGuid():N}{ext}";
            var filePath = Path.Combine(uploadsPath, fileName);

            await File.WriteAllBytesAsync(filePath, file.Data);

            await UnitOfWork.HotelImages.AddAsync(new HotelImage
            {
                HotelId = hotelId,
                FileName = fileName,
                Url = $"/uploads/hotels/{fileName}",
                IsPrimary = file.Name == primaryImageName,
                CreatedAt = DateTime.UtcNow
            });
        }

        if (selectedImages.Any())
            await UnitOfWork.SaveChangesAsync();
    }

    private void ToggleAmenity(int amenityId, bool isChecked)
    {
        if (isChecked)
        {
            if (!selectedAmenityIds.Contains(amenityId))
                selectedAmenityIds.Add(amenityId);
        }
        else
        {
            selectedAmenityIds.Remove(amenityId);
        }
    }

    private async Task HandleSubmit()
    {
        // Debug: Log current user ID
        System.Diagnostics.Debug.WriteLine($"[CreateHotel] currentUserId: '{currentUserId}'");
        
        if (string.IsNullOrEmpty(currentUserId))
        {
            errorMessage = "User not authenticated. Please log in again.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            hotel.OwnerId = currentUserId;
            hotel.IsApproved = false; // Requires admin approval
            hotel.IsPublished = hotel.IsPublished; // Use checkbox value
            
            // Ensure Latitude/Longitude are null if not set (avoids MySQL decimal precision issues)
            if (hotel.Latitude == 0) hotel.Latitude = null;
            if (hotel.Longitude == 0) hotel.Longitude = null;
            
            var createdHotel = await HotelService.CreateHotelAsync(hotel);

            // Save uploaded images
            if (selectedImages.Any())
            {
                await SaveHotelImages(createdHotel.Id);
            }

            // Add selected amenities
            if (selectedAmenityIds.Any())
            {
                foreach (var amenityId in selectedAmenityIds)
                {
                    await UnitOfWork.HotelAmenities.AddAsync(new HotelAmenity
                    {
                        HotelId = createdHotel.Id,
                        AmenityId = amenityId
                    });
                }
                await UnitOfWork.SaveChangesAsync();
            }

            if (hotel.IsPublished)
            {
                successMessage = $"Hotel '{createdHotel.Name}' created successfully and submitted for admin approval! You will be notified once it's reviewed. Redirecting...";
            }
            else
            {
                successMessage = $"Hotel '{createdHotel.Name}' saved as draft successfully! You can publish it later for admin approval. Redirecting...";
            }
            
            StateHasChanged();
            
            // Redirect after 3 seconds to allow user to read the message
            await Task.Delay(3000);
            NavigationManager.NavigateTo("/owner/hotels");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating hotel: {ex.Message}";
            // Log the full exception for debugging
            Console.WriteLine($"Hotel creation error: {ex}");
            if (ex.InnerException != null)
            {
                Console.WriteLine($"Inner exception: {ex.InnerException}");
                errorMessage += $" | Inner: {ex.InnerException.Message}";
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }


    private void Cancel()
    {
        NavigationManager.NavigateTo("/owner/dashboard");
    }
}
