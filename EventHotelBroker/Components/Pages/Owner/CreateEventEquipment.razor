@page "/owner/create-equipment"
@rendermode InteractiveServer
@using EventHotelBroker.Models
@using EventHotelBroker.Services
@using EventHotelBroker.Utils
@using EventHotelBroker.Repositories
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IEventService EventService
@inject IUnitOfWork UnitOfWork
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Environment

<PageTitle>Add Event Equipment - Safari Vents</PageTitle>

<link href="/css/create-equipment.css?v=27" rel="stylesheet" />

<div class="ce">
    <Breadcrumb Items="@breadcrumbItems" />

    <!-- Header -->
    <div class="ce-header">
        <div>
            <h1 class="ce-header-title"><i class="bi bi-box-seam"></i> Add Event Equipment</h1>
            <p class="ce-header-sub">Add new rental equipment or event infrastructure to your catalog</p>
        </div>
        <button class="ce-btn ce-btn-cancel" @onclick="Cancel">
            <i class="bi bi-arrow-left"></i> Back to Equipment
        </button>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); border-radius: 8px; padding: 10px 14px; margin: 0 auto 14px auto; max-width: 1240px; display: flex; align-items: center; gap: 8px; font-size: 12px; color: #065F46;">
            <i class="bi bi-check-circle-fill" style="color: #10B981;"></i>
            <span><strong>Success!</strong> @successMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background: rgba(220,53,69,0.08); border: 1px solid rgba(220,53,69,0.25); border-radius: 8px; padding: 10px 14px; margin: 0 auto 14px auto; max-width: 1240px; display: flex; align-items: center; gap: 8px; font-size: 12px; color: #991B1B;">
            <i class="bi bi-exclamation-triangle-fill" style="color: #DC2626;"></i>
            <span><strong>Error!</strong> @errorMessage</span>
        </div>
    }

    <EditForm Model="@equipment" OnValidSubmit="@HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-errors" />

        <div class="ce-layout">
            <!-- Left Main Column -->
            <div class="ce-col-main">
                <!-- Equipment Details & Pricing Card -->
                <div class="ce-card">
                    <div class="ce-card-header">
                        <h6 class="ce-card-header-title"><i class="bi bi-box-seam"></i> Equipment Details &amp; Pricing</h6>
                    </div>
                    <div class="ce-card-body">
                        <!-- Row 1: Name & Category -->
                        <div class="ce-grid-name-cat">
                            <div class="ce-field">
                                <label class="ce-label">Equipment Name <span class="req">*</span></label>
                                <InputText @bind-Value="equipment.Name" class="ce-input" placeholder="e.g., White Wedding Tent 20x30" />
                                <ValidationMessage For="@(() => equipment.Name)" />
                            </div>
                            <div class="ce-field">
                                <label class="ce-label">Category <span class="req">*</span></label>
                                <InputSelect @bind-Value="equipment.Category" class="ce-select">
                                    <option value="">Select Category</option>
                                    <option value="Tents">Tents</option>
                                    <option value="Chairs">Chairs</option>
                                    <option value="Sound System">Sound System</option>
                                    <option value="Lighting">Lighting</option>
                                    <option value="Catering">Catering</option>
                                    <option value="Decoration">Decoration</option>
                                    <option value="Tables">Tables</option>
                                    <option value="Stage">Stage & Platform</option>
                                    <option value="Audio Visual">Audio Visual</option>
                                    <option value="Other">Other</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => equipment.Category)" />
                            </div>
                        </div>

                        <!-- Row 2: Price, Unit & Quantity -->
                        <div class="ce-grid-3">
                            <div class="ce-field">
                                <label class="ce-label">Price Per Unit (KES) <span class="req">*</span></label>
                                <div class="ce-input-group">
                                    <span class="ce-input-prefix">KES</span>
                                    <InputNumber @bind-Value="equipment.PricePerUnit" class="ce-input" placeholder="0.00" step="0.01" />
                                </div>
                                <ValidationMessage For="@(() => equipment.PricePerUnit)" />
                            </div>
                            <div class="ce-field">
                                <label class="ce-label">Unit Type <span class="req">*</span></label>
                                <InputSelect @bind-Value="equipment.Unit" class="ce-select">
                                    <option value="">Select Unit</option>
                                    <option value="piece">Piece</option>
                                    <option value="set">Set</option>
                                    <option value="hour">Hour</option>
                                    <option value="day">Day</option>
                                    <option value="package">Package</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => equipment.Unit)" />
                            </div>
                            <div class="ce-field">
                                <label class="ce-label">Available Quantity <span class="req">*</span></label>
                                <InputNumber @bind-Value="equipment.AvailableQuantity" class="ce-input" placeholder="0" min="0" />
                                <ValidationMessage For="@(() => equipment.AvailableQuantity)" />
                            </div>
                        </div>

                        <!-- Row 3: Description -->
                        <div class="ce-field">
                            <label class="ce-label">Description <span class="req">*</span></label>
                            <InputTextArea @bind-Value="equipment.Description" class="ce-input" rows="2"
                                placeholder="Provide detailed description of the equipment, its condition, and included accessories..." />
                            <ValidationMessage For="@(() => equipment.Description)" />
                        </div>

                        <!-- Row 4: Specifications -->
                        <div class="ce-field">
                            <label class="ce-label">Specifications (Optional)</label>
                            <InputTextArea @bind-Value="equipment.Specifications" class="ce-input" rows="2"
                                placeholder="e.g., Dimensions: 20x30 ft, Material: Heavy-duty PVC, Power: 240V / 1500W..." />
                            <span class="ce-hint">Technical details, size, dimensions, power requirements, or setup constraints.</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Sidebar Column (Sticky) -->
            <div class="ce-col-side">
                <!-- Availability & Actions Card -->
                <div class="ce-card">
                    <div class="ce-card-header">
                        <h6 class="ce-card-header-title"><i class="bi bi-sliders"></i> Availability &amp; Save</h6>
                    </div>
                    <div class="ce-card-body">
                        <!-- Toggle -->
                        <label class="ce-toggle-box">
                            <div>
                                <span class="ce-toggle-label">Available for Booking</span>
                                <span class="ce-toggle-hint">Allow customers to rent this item</span>
                            </div>
                            <InputCheckbox @bind-Value="equipment.IsAvailable" id="isAvailable" style="width: 18px; height: 18px; cursor: pointer; accent-color: #DD7A28;" />
                        </label>

                        <button type="submit" class="ce-btn ce-btn-submit-block" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="ce-spinner me-1"></span>
                                <span>Saving Equipment...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg"></i>
                                <span>Add Equipment</span>
                            }
                        </button>
                        <button type="button" class="ce-btn ce-btn-cancel-block" @onclick="Cancel">
                            <i class="bi bi-x-lg"></i> Cancel
                        </button>
                    </div>
                </div>

                <!-- Equipment Images Card -->
                <div class="ce-card">
                    <div class="ce-card-header">
                        <h6 class="ce-card-header-title"><i class="bi bi-images"></i> Equipment Images</h6>
                    </div>
                    <div class="ce-card-body">
                        <div class="ce-dropzone-compact">
                            <InputFile OnChange="OnImagesSelected" multiple accept="image/*"
                                style="position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;" />
                            <i class="bi bi-cloud-arrow-up"></i>
                            <div class="ce-dropzone-text">Click or drop photos here</div>
                            <div class="ce-dropzone-sub">Max 5 photos · Up to 5MB each</div>
                        </div>

                        @if (selectedImages.Any())
                        {
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px;">
                                @foreach (var img in selectedImages)
                                {
                                    <div style="position: relative; border: 1px solid @(primaryImageName == img.Name ? "#DD7A28" : "#E5E7EB"); border-radius: 8px; overflow: hidden; background: #FAFAFA;">
                                        @if (imagePreviewUrls.ContainsKey(img.Name))
                                        {
                                            <img src="@imagePreviewUrls[img.Name]" style="width: 100%; height: 75px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div style="width: 100%; height: 75px; display: flex; align-items: center; justify-content: center; background: #F3F4F6;">
                                                <i class="bi bi-image" style="font-size: 1.2rem; color: #9CA3AF;"></i>
                                            </div>
                                        }
                                        <div style="padding: 4px 6px; display: flex; align-items: center; justify-content: space-between; font-size: 10px;">
                                            <label style="display: flex; align-items: center; gap: 4px; cursor: pointer; margin: 0;">
                                                <input type="radio" name="primaryImage" checked="@(primaryImageName == img.Name)"
                                                    @onchange="() => primaryImageName = img.Name" style="accent-color: #DD7A28; width: 12px; height: 12px;" />
                                                <span style="color: @(primaryImageName == img.Name ? "#DD7A28" : "#6B7280"); font-weight: @(primaryImageName == img.Name ? "700" : "500");">Cover</span>
                                            </label>
                                            <button type="button" @onclick="() => RemoveImage(img.Name)"
                                                style="background: none; border: none; color: #DC2626; cursor: pointer; padding: 0; font-size: 11px;">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Tips Card (Styled correctly) -->
                <div class="ce-card">
                    <div class="ce-card-body" style="padding: 12px 14px;">
                        <div class="ce-tips-title"><i class="bi bi-info-circle"></i> Important Information</div>
                        <div class="ce-tip"><i class="bi bi-check-circle-fill"></i><span>Equipment is submitted for admin review before appearing live in searches.</span></div>
                        <div class="ce-tip"><i class="bi bi-check-circle-fill"></i><span>Clear photos and detailed dimensions significantly improve client booking conversion.</span></div>
                        <div class="ce-tip"><i class="bi bi-check-circle-fill"></i><span>Set competitive pricing based on local market rental standards.</span></div>
                        <div class="ce-tip"><i class="bi bi-check-circle-fill"></i><span>Keep inventory numbers accurate to prevent scheduling overlap.</span></div>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
</div>

@code {
    private EventEquipment equipment = new();
    private bool isSubmitting = false;
    private string? currentProviderId;
    private string? errorMessage;
    private string? successMessage;

    private List<UploadedFileData> selectedImages = new();
    private Dictionary<string, string> imagePreviewUrls = new();
    private string? primaryImageName;
    private const long MaxFileSize = 5 * 1024 * 1024;

    private List<BreadcrumbItem> breadcrumbItems = new()
    {
        new BreadcrumbItem { Text = "Home", Url = "/" },
        new BreadcrumbItem { Text = "Event Equipments", Url = "/owner/event-equipments" },
        new BreadcrumbItem { Text = "Add Equipment", IsActive = true }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var token = await JSRuntime.InvokeAsync<string>("authHelpers.getCookie", "JWToken");
                if (!string.IsNullOrEmpty(token))
                {
                    var customAuth = (CustomAuthenticationStateProvider)AuthStateProvider;
                    await customAuth.MarkUserAsAuthenticated(token);
                    currentProviderId = await GetCurrentUserIdAsync();
                }

                if (string.IsNullOrEmpty(currentProviderId))
                {
                    errorMessage = "You must be logged in to add equipment.";
                }
                else
                {
                    equipment.ProviderId = currentProviderId;
                    equipment.IsAvailable = false;
                    equipment.IsApproved = false;
                    equipment.CreatedAt = DateTime.UtcNow;
                    equipment.UpdatedAt = DateTime.UtcNow;
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error: {ex.Message}";
            }
            StateHasChanged();
        }
    }

    private async Task<string?> GetCurrentUserIdAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState?.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                var nameClaim = user.FindFirst(ClaimTypes.Name)?.Value;
                if (!string.IsNullOrEmpty(nameClaim))
                {
                    var parts = nameClaim.Split(',');
                    if (parts.Length > 0) return parts[0];
                }
            }
        }
        catch { }
        return null;
    }

    private async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var files = e.GetMultipleFiles(5);
            foreach (var file in files)
            {
                if (selectedImages.Count >= 5) break;
                if (file.Size > MaxFileSize) { errorMessage = $"File '{file.Name}' exceeds 5MB limit."; continue; }
                if (!file.ContentType.StartsWith("image/")) continue;

                var uploaded = await UploadedFileData.FromBrowserFileAsync(file, MaxFileSize);
                if (uploaded != null)
                {
                    selectedImages.Add(uploaded);
                    imagePreviewUrls[uploaded.Name] = uploaded.PreviewUrl;
                    if (primaryImageName == null) primaryImageName = uploaded.Name;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing image: {ex.Message}";
        }
        StateHasChanged();
    }

    private void RemoveImage(string name)
    {
        selectedImages.RemoveAll(f => f.Name == name);
        imagePreviewUrls.Remove(name);
        if (primaryImageName == name) primaryImageName = selectedImages.FirstOrDefault()?.Name;
        StateHasChanged();
    }

    private async Task SaveEquipmentImages(int equipmentId)
    {
        var webRoot = Environment.WebRootPath ?? Path.Combine(Environment.ContentRootPath, "wwwroot");
        var uploadsPath = Path.Combine(webRoot, "uploads", "equipment");
        Directory.CreateDirectory(uploadsPath);

        int order = 1;
        foreach (var file in selectedImages)
        {
            var ext = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(ext)) ext = ".jpg";
            var fileName = $"{equipmentId}_{Guid.NewGuid():N}{ext}";
            var filePath = Path.Combine(uploadsPath, fileName);

            await File.WriteAllBytesAsync(filePath, file.Data);

            await UnitOfWork.EventEquipmentImages.AddAsync(new EventEquipmentImage
            {
                EquipmentId = equipmentId,
                ImageUrl = $"/uploads/equipment/{fileName}",
                IsPrimary = file.Name == primaryImageName,
                DisplayOrder = order++,
                UploadedAt = DateTime.UtcNow
            });
        }

        if (selectedImages.Any())
            await UnitOfWork.SaveChangesAsync();
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrEmpty(currentProviderId))
        {
            errorMessage = "You must be logged in to add equipment.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            equipment.ProviderId = currentProviderId;
            equipment.IsApproved = false;
            equipment.IsAvailable = false;

            await EventService.CreateEquipmentAsync(equipment);

            if (selectedImages.Any())
            {
                await SaveEquipmentImages(equipment.Id);
            }

            successMessage = "Equipment added successfully! It will be visible after admin approval. Redirecting...";
            StateHasChanged();
            await Task.Delay(1500);
            Navigation.NavigateTo("/owner/event-equipments");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating equipment: {ex.Message}";
            if (ex.InnerException != null) errorMessage += $" | {ex.InnerException.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/owner/event-equipments");
    }
}
